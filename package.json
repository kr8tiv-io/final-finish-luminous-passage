{
  "name": "final-finish-epoxy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild:assets": "npm run assets:validate",
    "prebuild": "node scripts/validate-deployment-env.mjs && npm run validate:3d && npm run prebuild:assets && npm run validate:content",
    "build": "astro build",
    "build:staging": "node scripts/build-with-env.mjs staging",
    "build:production": "node scripts/build-with-env.mjs production",
    "start": "node ./dist/server/entry.mjs",
    "build:3d": "blender --background --factory-startup --python tools/blender/build_luminous_passage.py",
    "validate:3d": "node tools/blender/validate-committed-assets.mjs",
    "test:3d:node": "node --test tools/blender/tests/test_node_validator.mjs",
    "test:3d:contract": "blender --background --factory-startup --python tools/blender/tests/run_all.py",
    "validate:3d:blender": "npm run test:3d:contract && blender --background --factory-startup --python tools/blender/validate_exports.py",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:content": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "assets:brand": "node scripts/optimize-brand-assets.mjs",
    "assets:generate": "node scripts/generate-project-variants.mjs && node scripts/build-photo-manifest.mjs && node scripts/validate-project-assets.mjs",
    "assets:validate": "node scripts/validate-project-assets.mjs",
    "test:project-assets": "node --test tests/project-assets.test.mjs",
    "astro": "astro",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.2.9",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "nodemailer": "^9.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
