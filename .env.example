# Required deployment context. SITE_ENV is the single source of truth for crawlability and draft visibility.
SITE_ENV=staging
PUBLIC_SITE_URL=https://staging.example.com

# Quote delivery — Hostinger SMTP is preferred; Resend is the fallback.
QUOTE_RECIPIENT=finalfinishepoxy@gmail.com
QUOTE_SENDER=Final Finish Website <website@finalfinishepoxy.ca>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional, consent-gated floor detection.
FAL_KEY=
