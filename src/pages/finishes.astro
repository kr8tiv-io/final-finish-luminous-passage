---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import InteriorHero from '../components/InteriorHero.astro'; import SectionShell from '../components/SectionShell.astro'; import { finishCssBackground, finishPresets } from '../lib/visualizer/finishes';
import FinishOrbit from '../components/motion/FinishOrbit.astro';
const groups = ['flake', 'solid', 'metallic'] as const;
---
<BaseLayout title="Epoxy Floor Finish Inspiration | Final Finish Edmonton" description="Explore 30 flake, solid and metallic epoxy floor design inspirations." canonicalPath="/finishes" imagePath="/images/brand/luminous-finish-hall.jpg"><SiteHeader /><main id="main-content"><InteriorHero eyebrow="The inspiration library" title="Three finish families. Thirty ways to begin." lead="These are visual directions, not SKUs. Exact colour, lighting, scale and system availability are confirmed with Final Finish." /><FinishOrbit placed="page" />{groups.map((group) => <SectionShell tone={group === 'solid' ? 'stone' : 'paper'}><p class="section-kicker">{group}</p><h2 class="section-title">{group === 'flake' ? 'Full-flake, quartz and large-format terrazzo.' : group === 'solid' ? 'Wet-look solids with a glass topcoat.' : '3D metallic: marble, ocean, copper, galaxy.'}</h2><div class="finish-cards">{finishPresets.filter((finish) => finish.family === group).map((finish) => <article><div style={`background:${finishCssBackground(finish)}`}></div><h3>{finish.name}</h3><p>{finish.description}</p></article>)}</div></SectionShell>)}</main><SiteFooter /></BaseLayout>
<style>.finish-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem;margin-top:3rem}.finish-cards article{padding:1rem;background:#fbfaf5;border:1px solid var(--line)}.finish-cards article>div{position:relative;aspect-ratio:1.15;overflow:hidden;box-shadow:inset 0 -2.5rem 3rem rgba(0,0,0,.18)}.finish-cards h3{margin:1rem 0 .4rem;font-family:var(--serif);font-size:1.6rem;font-weight:400}.finish-cards p{color:var(--muted);font-size:.75rem}@media(max-width:800px){.finish-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.finish-cards{grid-template-columns:1fr}}</style>
