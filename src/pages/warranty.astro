---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InteriorHero from '../components/InteriorHero.astro';
import SectionShell from '../components/SectionShell.astro';
---

<BaseLayout title="Epoxy Floor Warranty | Final Finish Edmonton" description="What a Final Finish epoxy quote covers, and what it does not. Terms are written into the quote—not invented on the website." canonicalPath="/warranty">
  <SiteHeader />
  <main id="main-content">
    <InteriorHero eyebrow="Written with the quote" title="Warranty is a document, not a slogan." lead="This site will not invent a year count or a lifetime promise. Coverage for prep, coating, and wear is confirmed in the quote Denis sends you." />
    <SectionShell>
      <p class="section-kicker">What you can expect</p>
      <h2 class="section-title">The quote names the terms.</h2>
      <p class="section-lead">Manufacturer product sheets and installer workmanship are different things. Final Finish will say which is which in writing before work starts. If a number is not in that quote, it is not a claim on this page.</p>
      <ul class="warranty-list">
        <li>Workmanship coverage is stated on the quote for that job.</li>
        <li>Product limits follow the system that was actually installed.</li>
        <li>Abuse, unapproved chemicals, moisture that was not disclosed, and later trades cutting the floor sit outside a coating warranty.</li>
        <li>Ask for the terms before you book. Call (780) 991-1651 if they are not already in the email.</li>
      </ul>
      <div class="button-row">
        <a class="button button-primary" href="/contact#quote">Request a quote</a>
        <a class="button button-secondary" href="/resources/floor-coating-warranty-questions">Warranty questions to ask</a>
      </div>
    </SectionShell>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .warranty-list { display: grid; gap: 0.85rem; max-width: 40rem; padding-left: 1.2rem; color: var(--muted); }
</style>
