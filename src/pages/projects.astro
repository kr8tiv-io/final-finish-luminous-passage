---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { StandaloneComparison, type ComparisonProject } from '../components/projects/Comparison';
import type { ImageVariant } from '../data/transformation-gallery';
import projectPhotos from '../data/project-photo-pairs.json';

/**
 * Same publication rule as the homepage proof act: a pairing claim is only
 * shown where it can be reviewed. None of these six curated pairs is approved
 * yet, so staging gets the live comparison behind the review note and
 * production gets six honest two-up figures — a single photograph carries no
 * pairing claim, so it needs no approval. There is deliberately no empty state.
 */
const allowPending = import.meta.env.DEV || import.meta.env.SITE_ENV === 'staging';

type Asset = (typeof projectPhotos.assets)[number];

const assets = new Map(projectPhotos.assets.map((asset) => [asset.id, asset]));

/**
 * Step 29 neutralised these six labels. The previous set asserted things about
 * individual photographs that nothing verifies: "Salt-worn slab", "Two-day garage
 * coating", and "Diamond-grind bay" each read a cause, a duration, or a method
 * off an image nobody has captioned yet. The pairs are still awaiting Denis's
 * approval (`docs/project-pair-approval-queue.md`), so a label may describe only
 * what the frame plainly shows. The two-day installation fact is A8-sourced and
 * still appears on `/process` and the service pages, where it is a statement about
 * how the work runs rather than about one photograph.
 */
const projectLabels = [
  'Edmonton garage floor, one',
  'Edmonton garage floor, two',
  'Edmonton garage floor, three',
  'Edmonton garage bay',
  'Edmonton garage bay, wide',
  'Edmonton shop floor',
];
const captions = [
  'The overhead door, side entry, and wall line are visible in both photographs.',
  'The wall junction and door opening hold the same angle across both frames.',
  'The slab edge and perimeter of the room read the same in both photographs.',
  'The same bay, photographed before preparation and after coating.',
  'The ground profile is visible in the first frame and coated in the second.',
  'The camera position is unchanged between the two photographs.',
];

/** `project-photo-pairs.json` carries no alt text; it is written per view here. */
const toVariant = (asset: Asset, alt: string): ImageVariant => ({
  avif: asset.variants.avif,
  webp: asset.variants.webp,
  jpeg: asset.variants.jpeg,
  thumbnail: asset.variants.thumbnail,
  width: asset.width,
  height: asset.height,
  alt,
  sourceUrl: asset.sourceUrl,
  crop: { objectPosition: '50% 52%' },
});

const comparisons: ComparisonProject[] = projectPhotos.curatedPairCandidates.map((pair, index) => {
  const label = projectLabels[index] ?? `Edmonton floor ${index + 1}`;
  return {
    id: pair.id,
    tabLabel: `${String(index + 1).padStart(2, '0')} / archive`,
    title: label,
    homeownerCaption: captions[index] ?? 'Both photographs are from the Final Finish project archive.',
    before: toVariant(assets.get(pair.beforeAssetIds[0])!, `${label}: concrete floor before coating`),
    after: toVariant(assets.get(pair.afterAssetIds[0])!, `${label}: finished coated floor`),
  };
});
---

<BaseLayout title="Epoxy Flooring Projects Edmonton | Final Finish" description="Explore real before-and-after concrete coating projects from Final Finish Epoxy in the Edmonton area." canonicalPath="/projects" imagePath="/images/projects/generated/jpeg/img_3313.jpg">
  <SiteHeader />
  <main id="main-content">
    <header class="projects-hero">
      <div class="hero-architecture" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="hero-copy">
        <p class="eyebrow">The Proof Arcade · Edmonton</p>
        <h1>The floor<br />is the <em>evidence.</em></h1>
        <div class="hero-deck">
          <p>Real photographs of finished work, paired from similar viewpoints. Nothing here is generated, and nothing is retouched.</p>
          <span>Drag · hover · use arrow keys</span>
        </div>
      </div>
      <a class="scroll-cue" href="#transformations"><span>Enter the archive</span><i aria-hidden="true">↓</i></a>
    </header>

    <section id="transformations" class="archive" aria-labelledby="archive-title">
      <div class="archive-intro">
        <p class="eyebrow">Six close viewpoints</p>
        <h2 id="archive-title">Move the threshold.<br />See the work.</h2>
        <p>Each pair was picked from the Final Finish project archive because the two frames sit at close to the same angle. The photographs are the work as shot.</p>
      </div>
      {allowPending && <p class="review-note">Project pairing review · not approved for publication</p>}
      <div class="comparison-grid" data-pairing-mode={allowPending ? 'review' : 'static'}>
        {comparisons.map((comparison) => allowPending ? (
          <StandaloneComparison client:visible project={comparison} loading="lazy" />
        ) : (
          <figure class="project-evidence">
            <div class="project-evidence-views">
              {[comparison.before, comparison.after].map((photo, view) => (
                <figure>
                  <picture>
                    <source type="image/avif" srcset={photo.avif} />
                    <source type="image/webp" srcset={photo.webp} />
                    <img src={photo.jpeg} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                  </picture>
                  <figcaption>{view === 0 ? 'Concrete preparation' : 'Finished surface'}</figcaption>
                </figure>
              ))}
            </div>
            <figcaption>{comparison.title}<small>Project pairing awaiting confirmation</small></figcaption>
          </figure>
        ))}
      </div>
      <aside class="review-key" aria-label="Project photo status">
        <span><i aria-hidden="true"></i>Real job photos</span>
        <p>Every image here is a Final Finish job, paired by camera angle. None of the afters is generated.</p>
      </aside>
    </section>

    <section class="project-cta">
      <p class="eyebrow">Your floor, next</p>
      <h2>Bring us the concrete<br />you have now.</h2>
      <p class="project-cta-lead">Send photos for a free estimate, or book a visit. Denis looks at the slab before anyone talks about colour.</p>
      <div><a class="button button-primary" href="/contact#quote">Request a quote</a><a class="text-link" href="/floor-visualizer">Try a finish in your room <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .projects-hero { position: relative; display: grid; min-height: 100svh; align-items: end; overflow: hidden; padding: clamp(10rem, 18vh, 14rem) var(--gutter) clamp(5rem, 8vw, 8rem); background: #f4f0e7; }
  .projects-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 30%, rgba(167,214,234,.72), transparent 34%), linear-gradient(180deg, #edf7fa 0%, #f4f0e7 65%); }
  .hero-architecture { position: absolute; inset: 5rem 3vw -1px; display: flex; justify-content: center; gap: clamp(.5rem, 2vw, 2.5rem); opacity: .52; }
  .hero-architecture i { width: min(18vw, 15rem); border: 1px solid rgba(37,83,109,.25); border-bottom: 0; border-radius: 9rem 9rem 0 0; background: linear-gradient(90deg, rgba(255,255,255,.2), rgba(255,255,255,.6), rgba(255,255,255,.12)); box-shadow: inset 0 0 0 .8rem rgba(255,255,255,.18); }
  .hero-architecture i:nth-child(1), .hero-architecture i:nth-child(5) { transform: translateY(16%); }
  .hero-architecture i:nth-child(2), .hero-architecture i:nth-child(4) { transform: translateY(7%); }
  .hero-copy { position: relative; z-index: 1; width: min(100%, var(--max)); margin: auto; }
  .hero-copy h1 { max-width: 70rem; margin: 1.3rem 0 3rem; color: var(--ink); font-family: var(--display); font-size: clamp(3.4rem, 8.4vw, 9.4rem); font-weight: 500; letter-spacing: .002em; line-height: .9; text-transform: uppercase; }
  .hero-copy h1 em { color: var(--cobalt); font-style: italic; font-weight: 400; text-transform: none; letter-spacing: -.01em; }
  .hero-deck { display: grid; grid-template-columns: minmax(0, 32rem) auto; gap: 2rem; align-items: end; }
  .hero-deck p { margin: 0; color: #526771; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.6; }
  .hero-deck span { color: #60747e; font-size: .62rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  .scroll-cue { position: absolute; z-index: 2; right: var(--gutter); bottom: 2rem; display: none; color: #183b50; }
  .archive { padding: clamp(6rem, 12vw, 12rem) var(--gutter); background: #fbfaf6; }
  .archive-intro, .comparison-grid, .review-key, .review-note { width: min(100%, var(--max)); margin-inline: auto; }
  .review-note { margin: 0 0 clamp(2rem, 4vw, 3rem); color: #72572b; font: 650 .875rem/1.5 var(--sans); letter-spacing: -.01em; }
  .archive-intro { display: grid; grid-template-columns: 1fr 2.2fr 1fr; gap: 3vw; align-items: start; margin-bottom: clamp(5rem, 10vw, 10rem); }
  .archive-intro h2 { margin: 0; font-family: var(--display); font-size: clamp(2.8rem, 6vw, 7rem); font-weight: 500; letter-spacing: .002em; line-height: .92; text-transform: uppercase; }
  .archive-intro > p:last-child { margin: .25rem 0 0; color: var(--muted); font-size: .86rem; line-height: 1.7; }
  /* One column: the shared comparison is a 4:3 stage with a caption row, and a
     two-up grid of them halves the drag distance the divider needs. */
  .comparison-grid { display: grid; gap: clamp(5rem, 8vw, 9rem); }
  .comparison-grid > :global(.transformation-comparison),
  .comparison-grid > .project-evidence { width: min(100%, 66rem); margin-inline: auto; }
  .project-evidence { margin: 0; }
  .project-evidence-views { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.4vw, 2rem); }
  .project-evidence-views figure { margin: 0; }
  .project-evidence-views picture, .project-evidence-views img { display: block; width: 100%; height: auto; }
  .project-evidence-views figcaption { padding-top: .6rem; color: var(--muted); font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .project-evidence > figcaption { display: grid; gap: .35rem; padding-top: 1.15rem; border-bottom: 1px solid var(--line); padding-bottom: 1.15rem; font-size: 1rem; font-weight: 550; }
  .project-evidence > figcaption small { color: var(--muted); font-size: .72rem; font-weight: 550; }
  .review-key { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; margin-top: 8rem; padding: 2rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: .75rem; }
  .review-key span { display: flex; align-items: center; gap: .55rem; color: #475b65; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .review-key i { width: .5rem; height: .5rem; border-radius: 50%; background: #d5a94a; }
  .review-key p { max-width: 45rem; margin: 0; line-height: 1.65; }
  .project-cta { padding: clamp(6rem, 12vw, 12rem) var(--gutter); background: radial-gradient(circle at 78% 25%, rgba(130,205,232,.26), transparent 30%), #153d58; color: white; }
  .project-cta > * { width: min(100%, var(--max)); margin-inline: auto; }
  .project-cta .eyebrow { color: #a9d9ec; }
  .project-cta h2 { margin-top: 1rem; font-family: var(--display); font-size: clamp(3rem, 7vw, 8rem); font-weight: 500; letter-spacing: .002em; line-height: .9; text-transform: uppercase; }
  .project-cta-lead { max-width: 42rem; margin: 2rem 0 0; color: #cfe3ee; line-height: 1.7; }
  .project-cta > div { display: flex; gap: 2rem; align-items: center; margin-top: 3rem; }
  .project-cta .text-link { color: white; font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 800px) { .hero-deck, .archive-intro, .review-key { grid-template-columns: 1fr; } .hero-deck span { display: none; } .project-evidence-views { grid-template-columns: 1fr; } .hero-architecture { inset-inline: -25vw; } .project-cta > div { align-items: flex-start; flex-direction: column; } }
</style>
