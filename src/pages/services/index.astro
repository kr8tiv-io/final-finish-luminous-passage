---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import InteriorHero from '../../components/InteriorHero.astro';
import SectionShell from '../../components/SectionShell.astro';

/**
 * Named `jsonLd` so the layout can read it as a prop once Step 32's structured-data
 * pass lands; until then it renders through `slot="head"`, which is the pattern the
 * rest of the tree already uses.
 *
 * Every answer below traces to `CONTEXT-SHEET.md` A8 and is logged in
 * `CLAIMS-LEDGER.md`. The previous service-area answer named six towns; A8 lists
 * towns beyond Edmonton as not claimable, so it now says what is true and points at
 * `/service-area`. Return-to-use timing, prices, and warranty terms are not on this
 * page in any form, because nothing sourced says what they are.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What areas do you serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Final Finish is based in Edmonton, Alberta, and works as a service-area business. Ask Denis whether he travels to your address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does a floor take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Installation usually runs two days. It varies with the concrete, so the schedule for your floor is confirmed before work starts.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I get an estimate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A free estimate can start from photos of the floor, or from an in-person visit. Prices are not published on this site.',
      },
    },
    {
      '@type': 'Question',
      name: 'When can I use the floor again?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Return-to-use timing is written into your quote. It depends on the system and the conditions that week, so this site does not guess it.',
      },
    },
  ],
};
---
<BaseLayout title="Epoxy Flooring Services Edmonton | Final Finish" description="Garage, residential, commercial, and concrete preparation services from Final Finish Epoxy in Edmonton. What each one is for, and how to choose." canonicalPath="/services">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />
  <main id="main-content">
    <InteriorHero
      eyebrow="Garage · Residential · Commercial · Concrete"
      title="Epoxy flooring services, built around the slab."
      lead="Denis quotes from the concrete in front of him, not from a package. Start with the page that matches your room, and bring photos."
    />

    <SectionShell>
      <p class="section-kicker">Pick the right page</p>
      <h2 class="section-title">Four services, and what each one answers.</h2>
      <div class="card-grid services-grid">
        <article class="editorial-card">
          <h2>Garage floor coating</h2>
          <p>The most common job we do. Flake, solid, or metallic over a ground and repaired slab, planned around vehicles, salt, and storage.</p>
          <a href="/services/garage-floor-coating-edmonton">Garage floor coating</a>
        </article>
        <article class="editorial-card">
          <h2>Residential epoxy</h2>
          <p>Barns, workshops, basements, kitchens, and bathrooms. Same preparation, different questions about texture, light, and how the room is lived in.</p>
          <a href="/services/residential-epoxy-flooring">Residential flooring</a>
        </article>
        <article class="editorial-card">
          <h2>Commercial epoxy</h2>
          <p>Warehouses, showrooms, and industrial facilities. Surface preparation, crack filling, and anti-slip finishes planned around your working day.</p>
          <a href="/services/commercial-epoxy-flooring">Commercial flooring</a>
        </article>
        <article class="editorial-card">
          <h2>Concrete solutions</h2>
          <p>Repair, levelling, restoration, and diamond grinding. The work that happens before a finish, and sometimes the whole job on its own.</p>
          <a href="/services/concrete-solutions">Concrete preparation</a>
        </article>
      </div>
    </SectionShell>

    <SectionShell tone="stone">
      <p class="section-kicker">The order of work</p>
      <h2 class="section-title">Every service starts the same way.</h2>
      <p class="section-lead">The finish is the last coat down, not the first decision. Preparation sets what the floor can be.</p>
      <ol class="order-list">
        <li><strong>A free estimate.</strong> Send photos of the floor, or book a visit. Denis looks at the concrete first.</li>
        <li><strong>Grinding.</strong> The slab is ground to open the surface before anything is applied.</li>
        <li><strong>Cosmetic crack filling.</strong> Visible cracks are filled as part of preparation.</li>
        <li><strong>The coating.</strong> Flake is broadcast, then scraped, then a top coat goes over it.</li>
        <li><strong>An anti-slip top coat, if the room needs one.</strong> That is a use decision, made with you.</li>
      </ol>
      <p>Installation usually runs two days, and it varies with the concrete. <a href="/process">The process page</a> walks through the same sequence in more detail.</p>
    </SectionShell>

    <SectionShell>
      <p class="section-kicker">Common questions</p>
      <h2 class="section-title">What people ask before a grind.</h2>
      <dl class="faq-list">
        <dt>What areas do you serve?</dt>
        <dd>Final Finish is based in Edmonton, Alberta, and works as a service-area business. Ask Denis whether he travels to your address. <a href="/service-area">Where we work</a>.</dd>
        <dt>How long does a floor take?</dt>
        <dd>Installation usually runs two days. It varies with the concrete, so your schedule is confirmed before work starts.</dd>
        <dt>How do I get an estimate?</dt>
        <dd>Send photos, or book a visit. The estimate is free. Prices are not published here, because every slab is different.</dd>
        <dt>When can I use the floor again?</dt>
        <dd>That timing belongs in your quote, not on a website. Ask for it in writing before you book. The <a href="/resources/how-epoxy-floor-coatings-cure/">cure guide</a> explains why the answer moves.</dd>
        <dt>Can you coat in winter?</dt>
        <dd>Salt, meltwater, and a cold slab all change the preparation. Send photos and Denis will tell you what the floor needs. The <a href="/resources/cold-weather-floor-coating-edmonton/">cold-weather guide</a> covers the questions to ask.</dd>
      </dl>
      <div class="button-row">
        <a class="button button-primary" href="/contact#quote">Send photos for an estimate</a>
        <a class="button button-secondary" href="/projects">See finished floors</a>
      </div>
    </SectionShell>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .order-list { display: grid; gap: 0.85rem; max-width: 48rem; margin: 2rem 0; padding-left: 1.3rem; color: #3f4e57; line-height: 1.65; }
  .order-list strong { color: var(--ink); font-weight: 650; }
  .faq-list { display: grid; gap: 1.4rem; max-width: 46rem; margin: 2rem 0 0; }
  .faq-list dt { font-family: var(--serif); font-size: 1.8rem; }
  .faq-list dd { margin: 0.4rem 0 0; color: var(--muted); }
  @media (max-width: 820px) { .services-grid { grid-template-columns: 1fr; } }
</style>
