---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import JourneyMotionLoader from '../components/motion/JourneyMotionLoader';
import FilmVeilLoader from '../components/motion/FilmVeilLoader';
import SocialProof from '../components/home/SocialProof.astro';
import ProjectStory from '../components/home/ProjectStory.astro';
import projectStories from '../data/home-project-stories.json';
import customerProof from '../data/customer-proof.json';
import { ratingIsCurrent } from '../lib/content/review-navigation';
import EditorialMotion from '../components/motion/EditorialMotion';
import MotionPreferenceControl from '../components/motion/MotionPreferenceControl';
import FloorPlanning from '../components/home/FloorPlanning.astro';
import TransformationGallery from '../components/projects/TransformationGallery';
import '../styles/journey.css';

const title = 'Final Finish Epoxy | Edmonton Epoxy Floor Coatings';
const description = 'Edmonton epoxy floor coatings for garages, homes, and commercial rooms. Denis and Final Finish prepare the slab, then build a flake, solid, or metallic finish that is easier to live with.';
const currentRating = ratingIsCurrent(customerProof.rating.verifiedAt, customerProof.rating.refreshAfterDays);
const ratingDate = new Intl.DateTimeFormat('en-CA', {month:'short',day:'numeric',year:'numeric',timeZone:'America/Edmonton'}).format(new Date(customerProof.rating.verifiedAt));
// Keep unapproved spatial work available for local review, not the client route.
const thresholdStudy = import.meta.env.DEV && Astro.url.searchParams.get('study') === 'threshold';
const chapterLinks = [
  ['portico', 'Surface'], ['foundation', 'Preparation'], ['garage', 'Your space'],
  ['vault', 'Basement'], ['finish-hall', 'Finishes'], ['commercial', 'Commercial'],
  ['proof', 'Projects'], ['consultation', 'Denis'],
];
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <MotionPreferenceControl client:load />

  <main id="main-content" class="journey" data-room="portico" data-threshold-study={thresholdStudy || undefined}>
    <JourneyMotionLoader client:only="react" />
    <EditorialMotion client:only="react" />
    <FilmVeilLoader client:only="react" enableThresholdStudy={thresholdStudy} />
    {thresholdStudy && <p class="threshold-study-note">Local 3D study · visual direction not approved</p>}
    <nav class="journey-rail" aria-label="Explore the floor journey">
      {chapterLinks.map(([id, label]) => (
        <a href={`#${id}`} data-journey-target={id}>{label}</a>
      ))}
    </nav>
    <section class="journey-chapter hero-chapter" id="portico" tabindex="-1" data-journey-chapter="portico" aria-labelledby="hero-title">
      <div class="pour-stage" aria-hidden="true">
        <img
          class="pour-poster"
          loading="eager"
          fetchpriority="high"
          src="/images/brand/epoxy-pour-poster.jpg"
          alt=""
          width="1280"
          height="720"
          decoding="async"
        />
        <video
          class="pour-film"
          muted
          playsinline
          disablepictureinpicture
          preload="none"
          poster="/images/brand/epoxy-pour-poster.jpg"
        >
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-pour.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-pour.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-light" aria-hidden="true"></div>
      <div class="chapter-content hero-content">
        <p class="eyebrow">Edmonton garage & commercial floor coatings</p>
        <h1 id="hero-title" class="display-title">A better floor.<br />A different feeling.</h1>
        <p class="lead">Epoxy flooring for Edmonton garages, basements, workshops, and commercial spaces. Careful preparation. A finish chosen around the way you use the room.</p>
        <div class="button-row">
          <a class="button button-primary" href="/contact#quote"><span>Request a quote</span><span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/floor-visualizer"><span>Try your floor</span></a>
          <a class="text-call" href="tel:+17809911651">Call Denis <span>(780) 991-1651</span></a>
        </div>
        <nav class="hero-ribbon" data-hero-ribbon aria-label="Follow the floor chapters">
          <span class="hero-ribbon-line" aria-hidden="true"></span>
          <a href="#portico"><span>01</span>The pour</a><a href="#customer-reviews"><span>02</span>The proof</a><a href="#proof"><span>03</span>Transformations</a><a href="#finish-hall"><span>04</span>Your finish</a>
        </nav>
      </div>

      <a class="hero-proof" href="#customer-reviews">{currentRating ? <><span aria-hidden="true">★★★★★</span> {customerProof.rating.value.toFixed(1)} · {customerProof.rating.count}+ Google reviews <small>Checked {ratingDate}</small></> : 'Hear from our customers'} <span aria-hidden="true">↓</span></a>
      <p class="chapter-index">01 / Follow the floor <span>Material concept film</span></p>
    </section>

    <SocialProof />

    <div class="journey-breath" data-hall-from="portico" data-hall-to="foundation" aria-hidden="true"></div>

    <section class="journey-chapter foundation-chapter" id="foundation" tabindex="-1" data-journey-chapter="foundation" aria-labelledby="foundation-title">
      <div class="floor-film pearl-stair" aria-hidden="true" data-concept-still>
        <picture><source type="image/avif" srcset="/images/brand/pearl-stair-v2.avif" /><source type="image/webp" srcset="/images/brand/pearl-stair-v2.webp" /><img class="floor-film-poster" loading="lazy" src="/images/brand/pearl-stair-v2.jpg" alt="" width="1672" height="941" decoding="async" /></picture>
      </div>
      <div class="chapter-content offset-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Preparation, repair, precision</p>
        <h2 id="foundation-title" class="chapter-title">The finish begins below the surface.</h2>
        <p class="lead">A beautiful finish starts with the concrete underneath. Denis assesses existing coatings, cracks, contamination, and moisture concerns before recommending preparation and a coating system.</p>
        <a class="chapter-link" href="/services/concrete-solutions">Explore concrete preparation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="material-lens" data-material-lens aria-label="Pearl-grey epoxy material concept, detail view">
        <div class="material-lens-glass"><img src="/images/brand/pearl-stair-v2.webp" alt="Detail of the softly reflective pearl-grey concept floor" width="1672" height="941" loading="lazy" /></div>
        <figcaption><span>01 / Surface study</span><strong>Pearl grey</strong><small>Illustrative material · not an installed project</small></figcaption>
      </figure>
      <p class="chapter-index" aria-hidden="true">02 / Beneath the finish <span>Architectural concept</span></p>
    </section>

    <div class="journey-breath" data-hall-from="foundation" data-hall-to="garage" aria-hidden="true"></div>

    <section class="journey-chapter garage-chapter" id="garage" tabindex="-1" data-journey-chapter="garage" aria-labelledby="garage-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-garage-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none" poster="/images/brand/epoxy-garage-poster.jpg">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-garage.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-garage.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">More room for your life</p>
        <h2 id="garage-title" class="chapter-title">Reclaim your garage or basement.</h2>
        <p class="lead">Make room for what you love. A workshop for the weekend. A place to train. Space for a hobby that has outgrown the kitchen table. Start with a floor that feels like part of your home.</p>
        <a class="chapter-link" href="/services/residential-epoxy-flooring">Residential epoxy flooring <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="chapter-index" aria-hidden="true">03 / Your space</p>
    </section>


    <div class="journey-breath" data-hall-from="garage" data-hall-to="vault" aria-hidden="true"></div>

    <section class="journey-chapter vault-chapter" id="vault" tabindex="-1" data-journey-chapter="vault" aria-labelledby="vault-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-basement-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none" poster="/images/brand/epoxy-basement-poster.jpg">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-basement.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-basement.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Below ground. Beyond storage.</p>
        <h2 id="vault-title" class="chapter-title">The space was always there.</h2>
        <p class="lead">A calmer hobby room, a home fitness area, or simply a more useful basement. Explore the finish first, then discuss the condition of your slab. A coating does not replace moisture remediation, ventilation, heating, or a complete renovation.</p>
        </div>
      </div>
      <p class="chapter-index" aria-hidden="true">03 / Another possibility</p>
    </section>

    <div class="journey-breath" data-hall-from="vault" data-hall-to="finish-hall" aria-hidden="true"></div>

    <section class="journey-chapter finish-chapter" id="finish-hall" tabindex="-1" data-journey-chapter="finish-hall" aria-labelledby="finish-title">
      <picture class="chapter-frame" data-chapter-frame aria-hidden="true">
        <source type="image/avif" srcset="/images/brand/luminous-finish-hall.avif" />
        <source type="image/webp" srcset="/images/brand/luminous-finish-hall.webp" />
        <img src="/images/brand/luminous-finish-hall.jpg" alt="" width="1680" height="941" loading="lazy" decoding="async" />
      </picture>
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-finish-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none" poster="/images/brand/epoxy-finish-poster.jpg">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-finish.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-finish.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Flake · Solid · Metallic</p>
        <h2 id="finish-title" class="chapter-title">Find your finish.</h2>
        <p class="lead">Quiet stone tones. A more expressive flake blend. A subtle metallic surface. Explore 30 inspiration finishes, compare favourites, and preview them in your own room before discussing available samples with Denis.</p>
        <div class="button-row">
          <a class="button button-secondary" href="/finishes"><span>Explore finishes</span></a>
          <a class="button button-primary" href="/floor-visualizer"><span>Make it yours</span></a>
        </div>
        </div>
      </div>
      <p class="chapter-index" aria-hidden="true">04 / The material studio</p>
    </section>

    <div class="journey-breath" data-hall-from="finish-hall" data-hall-to="commercial" aria-hidden="true"></div>

    <section class="journey-chapter commercial-chapter" id="commercial" tabindex="-1" data-journey-chapter="commercial" aria-labelledby="commercial-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-commercial-poster.jpg" alt="" width="1280" height="720" decoding="async" />
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Commercial epoxy flooring</p>
        <h2 id="commercial-title" class="chapter-title">Built around your working day.</h2>
        <p class="lead">A shop floor, a showroom, a shared corridor. The right recommendation starts with how the space operates: traffic, cleaning, access, preparation, and the time you can set aside for installation.</p>
        <a class="chapter-link" href="/services/commercial-epoxy-flooring">Commercial epoxy flooring <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="chapter-index" aria-hidden="true">A route for business</p>
    </section>

    <div class="journey-breath" data-hall-from="commercial" data-hall-to="proof" aria-hidden="true"></div>

    <section class="journey-chapter proof-chapter white-stage" id="proof" tabindex="-1" data-journey-chapter="proof" data-journey-white-stage aria-label="Real Final Finish transformations">
      <TransformationGallery client:visible />
      <div class="gallery-project-link editorial-width"><a class="chapter-link" href="/projects">Explore the project archive <span aria-hidden="true">↗</span></a></div>
    </section>

    <ProjectStory story={projectStories[2]} />

    <FloorPlanning />

    <div class="journey-breath" data-hall-from="proof" data-hall-to="consultation" aria-hidden="true"></div>

    <section class="journey-chapter consultation-chapter" id="consultation" tabindex="-1" data-journey-chapter="consultation" aria-labelledby="consultation-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-consultation-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none" poster="/images/brand/epoxy-consultation-poster.jpg">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-consultation.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-consultation.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content consultation-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Your next step</p>
        <h2 id="consultation-title" class="chapter-title">Let’s talk about your space.</h2>
        <p class="lead">Tell Denis where the space is, how you use it, and what you would like to change. An approximate size and any concerns about the concrete help start a useful conversation. Preparation, repairs, finish choice, and access all shape the quote.</p>
        <div class="button-row">
          <a class="button button-primary" href="/floor-visualizer"><span>Preview a finish</span></a>
          <a class="button button-secondary" href="/contact#quote"><span>Request a quote</span></a>
        </div>
        <div class="trust-line">
          <p><a href="tel:+17809911651">Call Denis · (780) 991-1651</a><br /><a href="mailto:finalfinishepoxy@gmail.com">finalfinishepoxy@gmail.com</a></p>
        </div>
        </div>
      </div>
      <p class="chapter-index" aria-hidden="true">06 / Talk to Denis</p>
    </section>

    <div class="journey-breath journey-breath--end" aria-hidden="true"></div>
  </main>

  <SiteFooter />
</BaseLayout>
