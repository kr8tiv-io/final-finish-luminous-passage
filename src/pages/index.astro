---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import JourneyMotionLoader from '../components/motion/JourneyMotionLoader';
import FilmVeilLoader from '../components/motion/FilmVeilLoader';
import SocialProof from '../components/home/SocialProof.astro';
import ProjectStory from '../components/home/ProjectStory.astro';
import projectStories from '../data/home-project-stories.json';
import customerProof from '../data/customer-proof.json';
import { ratingIsCurrent } from '../lib/content/review-navigation';
import EditorialMotion from '../components/motion/EditorialMotion';
import MotionPreferenceControl from '../components/motion/MotionPreferenceControl';
import FloorPlanning from '../components/home/FloorPlanning.astro';
import TransformationGallery from '../components/projects/TransformationGallery';
import ChapterReading from '../components/home/ChapterReading.astro';
import PreparationLayers from '../components/home/PreparationLayers.astro';
import ResinReveal from '../components/home/ResinReveal.astro';
import ReclaimBay from '../components/home/ReclaimBay.astro';
import '../styles/journey.css';
import '../styles/reclaim-bay.css';

const title = 'Final Finish Epoxy | Edmonton Epoxy Floor Coatings';
const description = 'Edmonton epoxy floor coatings for garages, homes, and commercial rooms. Denis and Final Finish prepare the slab, then build a flake, solid, or metallic finish that is easier to live with.';
const currentRating = ratingIsCurrent(customerProof.rating.verifiedAt, customerProof.rating.refreshAfterDays);
const ratingDate = new Intl.DateTimeFormat('en-CA', {month:'short',day:'numeric',year:'numeric',timeZone:'America/Edmonton'}).format(new Date(customerProof.rating.verifiedAt));
// Keep unapproved spatial work available for local review, not the client route.
const thresholdStudy = import.meta.env.DEV && Astro.url.searchParams.get('study') === 'threshold';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <MotionPreferenceControl client:load />

  <main id="main-content" class="journey" data-room="portico" data-threshold-study={thresholdStudy || undefined}>
    <JourneyMotionLoader client:only="react" />
    <EditorialMotion client:only="react" />
    <FilmVeilLoader client:only="react" enableThresholdStudy={thresholdStudy} />
    {thresholdStudy && <p class="threshold-study-note">Local 3D study · visual direction not approved</p>}
    {/*
      Act 1 is a sticky-in-flow act (storyboard §2 "Vertical, sticky · 2.6 vh
      (phone 2.2)", §6 "Sticky-in-flow host, 100lvh, no fixed layers"). The
      SECTION carries the act's scroll span — the director measures the chapter's
      rect, so the span has to be the section's own height — and `.hero-stage` is
      the one viewport the visitor looks at while that span runs. The reading layer
      moves into it — the wash, the copy, the proof line and the act label — so a
      2.6 vh act never stretches a one-viewport gradient across three of them, and
      the absolutely positioned `.hero-proof` / `.chapter-index` keep resolving
      `left: var(--gutter)` against a full-width box, exactly as before. The plate
      stays outside it; see the note on it below.
    */}
    <section class="journey-chapter hero-chapter" id="portico" tabindex="-1" data-journey-chapter="portico" aria-labelledby="hero-title">
      {/*
        The plate stays a DIRECT child of the chapter. `journey.css` and
        `readable-experience.css` both stage it with `[data-media-active] > .pour-stage`
        — one for `opacity`, one for `position: fixed` — and a plate moved inside the
        host silently fails both: measured, the hero rendered as bare paper with the
        copy floating on it. Once staged it is `position: fixed`, so the act's length
        cannot reach it; while unstaged it keeps the `height: 99svh` top-of-act
        framing `readable-experience.css` gives it for the LCP entry.
      */}
      <div class="pour-stage" aria-hidden="true">
        {/*
          The phone is capped at the 854w rung by a `media` source rather than by a
          `sizes` figure that misdescribes a full-bleed plate. At 390 px / DPR 3 the
          density ladder asked for 1170w and took the 1280w file (95,140 B); this
          hands it the 480 rung (50,658 B) and leaves the ladder untouched on
          desktop. The `<img>` keeps its own src/srcset and is still the LCP element.
        */}
        <picture>
          <source media="(max-width: 680px)" srcset="/images/brand/follow-floor/480/epoxy-pour-pearl-poster.jpg" />
          <img
            class="pour-poster"
            loading="eager"
            fetchpriority="high"
            src="/images/brand/follow-floor/720/epoxy-pour-pearl-poster.jpg"
            srcset="/images/brand/follow-floor/480/epoxy-pour-pearl-poster.jpg 854w, /images/brand/follow-floor/720/epoxy-pour-pearl-poster.jpg 1280w, /images/brand/follow-floor/1080/epoxy-pour-pearl-poster.jpg 1920w"
            sizes="100vw"
            alt=""
            width="1280"
            height="720"
            decoding="async"
          />
        </picture>
        <video
          class="pour-film"
          muted
          playsinline
          disablepictureinpicture
          preload="none"
        >
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-pour-pearl.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-pour-pearl.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-stage">
      <div class="hero-light" aria-hidden="true"></div>
      <div class="chapter-content hero-content">
        <p class="eyebrow">Edmonton garage & commercial floor coatings</p>
        <h1 id="hero-title" class="display-title">A better floor changes the whole space.</h1>
        <p class="lead">Epoxy floor coatings for Edmonton garages, workshops, and commercial spaces. Thoughtful preparation. A finish chosen around you.</p>
        <div class="button-row">
          <a class="button button-primary" href="/contact#quote"><span>Request a quote</span><span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/floor-visualizer"><span>Try your floor</span></a>
          <a class="text-call" href="tel:+17809911651">Call Denis <span>(780) 991-1651</span></a>
        </div>
        <nav class="hero-ribbon" data-hero-ribbon aria-label="Follow the floor chapters">
          <span class="hero-ribbon-line" aria-hidden="true"></span>
          <a href="#portico">The pour</a><a href="#customer-reviews">The proof</a><a href="#proof">See the difference</a><a href="#finish-hall">Your finish</a>
        </nav>
      </div>

      <a class="hero-proof" href="#customer-reviews">{currentRating ? <><span aria-hidden="true">★★★★★</span> {customerProof.rating.value.toFixed(1)} · {customerProof.rating.count}+ Google reviews <small>Checked {ratingDate}</small></> : 'Hear from our customers'} <span aria-hidden="true">↓</span></a>
      <p class="chapter-index" data-act-label>01 / The pour <span>Material concept film</span></p>
      </div>
    </section>

    <SocialProof />

    <div class="journey-breath" data-hall-from="portico" data-hall-to="foundation" aria-hidden="true"></div>

    <section class="journey-chapter foundation-chapter" id="foundation" tabindex="-1" data-journey-chapter="foundation" aria-labelledby="foundation-title">
      {/*
        Act 3, option A (storyboard §5, ASSET-LEDGER "pearl-graded walkway film"):
        the stair is the pearl-graded walkway film scrubbed by scroll, the same
        contract as the pour, with `FOUNDATION_STAIR_TIMING` as its window so the
        act keeps coherent bookend frames around the authored walk. The poster is
        frame 0 of that master, so poster and first scrubbed frame are the same
        picture. Option B (the 2.5D `DepthPlate` stair) stays on `/lab/stairs`.
      */}
      <div class="floor-film pearl-walk" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-walkway-pearl-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-walkway-pearl.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-walkway-pearl.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content offset-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Preparation, repair, precision</p>
        <h2 id="foundation-title" class="chapter-title">The finish begins below the surface.</h2>
        </div>
      </div>
      <figure class="material-lens" data-material-lens aria-label="Pearl-grey epoxy material concept, detail view">
        <div class="material-lens-glass"><img src="/images/brand/pearl-stair-v2.webp" alt="Detail of the softly reflective pearl-grey concept floor" width="1672" height="941" loading="lazy" /></div>
        <figcaption><span>01 / Surface study</span><strong>Pearl grey</strong><small>Illustrative material · not an installed project</small></figcaption>
      </figure>
      <p class="chapter-index" data-act-label aria-hidden="true">03 / Beneath the surface <span>Architectural concept</span></p>
    </section>

    <ChapterReading id="foundation" number="03" label="What happens beneath the finish" href="/services/concrete-solutions" link="Explore concrete preparation">
      <p>A beautiful finish starts with the concrete underneath. Discuss existing coatings, cracks, contamination, and moisture concerns with Denis before choosing a coating system.</p>
      <p>The assessment guides the preparation. It is the part you may not see in the finished photograph, but it deserves just as much attention.</p>
      <PreparationLayers />
    </ChapterReading>

    <div class="journey-breath" data-hall-from="foundation" data-hall-to="garage" aria-hidden="true"></div>

    <ReclaimBay rooms={['garage', 'vault', 'mancave']}>
      <Fragment slot="headline">
        <div class="chapter-content">
          <div class="chapter-copy-surface">
            <p class="eyebrow">More room for your life</p>
            <h2 id="reclaim-title" class="chapter-title">Reclaim your garage or basement.</h2>
            <p class="reclaim-second-line">Make room for what you love.</p>
          </div>
        </div>
      </Fragment>

      <section class="journey-chapter reclaim-room garage-chapter" id="garage" tabindex="-1" data-journey-chapter="garage" data-bay-room="garage" style="--bay-slot:0" aria-labelledby="garage-title">
        <div class="floor-film" aria-hidden="true">
          <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-garage-poster.jpg" alt="" width="1280" height="720" decoding="async" />
          <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none">
            <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-garage.mp4" type="video/mp4" />
            <source src="/videos/follow-floor/720/epoxy-garage.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="reclaim-room__copy">
          <h2 id="garage-title" class="reclaim-room-title">The workshop. The gym. The car you look after.</h2>
          <p class="reclaim-room-sub">Garage floors for vehicles, storage, equipment, and everyday use.</p>
        </div>
        <p class="chapter-index" data-act-label aria-hidden="true">04 / Reclaim · garage <span>Architectural concept · not an installed project</span></p>
      </section>

      <div class="journey-breath" data-hall-from="garage" data-hall-to="vault" aria-hidden="true"></div>

      <section class="journey-chapter reclaim-room vault-chapter" id="vault" tabindex="-1" data-journey-chapter="vault" data-bay-room="vault" style="--bay-slot:1" aria-labelledby="vault-title">
        <div class="floor-film" aria-hidden="true">
          <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-basement-poster.jpg" alt="" width="1280" height="720" decoding="async" />
          <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none">
            <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-basement.mp4" type="video/mp4" />
            <source src="/videos/follow-floor/720/epoxy-basement.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="reclaim-room__copy">
          <h2 id="vault-title" class="reclaim-room-title">The space was always there.</h2>
          <p class="reclaim-room-sub">A hobby room, a place to train, or simply a more useful basement.</p>
        </div>
        <p class="chapter-index" data-act-label aria-hidden="true">04 / Reclaim · basement <span>Architectural concept · not an installed project</span></p>
      </section>

      <div class="journey-breath" data-hall-from="vault" data-hall-to="mancave" aria-hidden="true"></div>

      <section class="journey-chapter reclaim-room mancave-chapter" id="mancave" tabindex="-1" data-journey-chapter="mancave" data-bay-room="mancave" style="--bay-slot:2" aria-labelledby="mancave-title">
        <div class="floor-film" aria-hidden="true">
          <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-mancave-poster.jpg" alt="" width="1280" height="720" decoding="async" />
          <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none">
            <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-mancave.mp4" type="video/mp4" />
            <source src="/videos/follow-floor/720/epoxy-mancave.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="reclaim-room__copy">
          <h2 id="mancave-title" class="reclaim-room-title">A lounge below the house.</h2>
          <p class="reclaim-room-sub">Storage that became a room.</p>
        </div>
        <p class="chapter-index" data-act-label aria-hidden="true">04 / Reclaim · lounge <span>Architectural concept · not an installed project</span></p>
      </section>
    </ReclaimBay>

    <ChapterReading id="mancave" number="04" label="Make room for what you love" href="/services/residential-epoxy-flooring" link="Explore residential floors">
      <p>A workshop for the weekend. A place to train. Space for a hobby that has outgrown the kitchen table. The floor is a sensible place to start making an underused room feel considered.</p>
      <p>Tell us what the space has to hold: vehicles, storage, equipment, or everyday use. That narrows the finish before anyone settles on a colour.</p>
      <p>A coating is one part of a room. It does not replace moisture remediation, ventilation, heating, or a full renovation.</p>
    </ChapterReading>

    <div class="journey-breath" data-hall-from="mancave" data-hall-to="proof" aria-hidden="true"></div>

    <section class="journey-chapter proof-chapter white-stage" id="proof" tabindex="-1" data-journey-chapter="proof" data-journey-white-stage aria-label="Real Final Finish transformations">
      <TransformationGallery client:visible={{ rootMargin: '800px' }} allowPending={import.meta.env.DEV || import.meta.env.SITE_ENV === 'staging'} />
      <div class="gallery-project-link editorial-width"><a class="chapter-link" href="/projects">Explore the project archive <span aria-hidden="true">↗</span></a></div>
      <p class="chapter-index" data-act-label aria-hidden="true">05 / See the difference <span>Edmonton project archive</span></p>
    </section>

    <div class="journey-breath" data-hall-from="proof" data-hall-to="finish-hall" aria-hidden="true"></div>

    <section class="journey-chapter finish-chapter" id="finish-hall" tabindex="-1" data-journey-chapter="finish-hall" aria-labelledby="finish-title">
      <picture class="chapter-frame" data-chapter-frame aria-hidden="true">
        <source type="image/avif" srcset="/images/brand/luminous-finish-hall.avif" />
        <source type="image/webp" srcset="/images/brand/luminous-finish-hall.webp" />
        <img src="/images/brand/luminous-finish-hall.jpg" alt="" width="1680" height="941" loading="lazy" decoding="async" />
      </picture>
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-finish-poster.jpg" alt="" width="1280" height="720" decoding="async" />
        <video class="floor-film-video" muted playsinline disablepictureinpicture preload="none">
          <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-finish.mp4" type="video/mp4" />
          <source src="/videos/follow-floor/720/epoxy-finish.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Flake · Solid · Metallic</p>
        <h2 id="finish-title" class="chapter-title">Find your finish.</h2>
        <div class="button-row">
          <a class="button button-secondary" href="/finishes"><span>Explore finishes</span></a>
          <a class="button button-primary" href="/floor-visualizer"><span>Make it yours</span></a>
        </div>
        </div>
      </div>
      <p class="chapter-index" data-act-label aria-hidden="true">07 / Your finish <span>Material concept film</span></p>
    </section>

    <ResinReveal />

    <ChapterReading id="finish-hall" number="07" label="A finish, not just a colour" href="/floor-visualizer" link="Preview your own floor">
      <p>Quiet stone tones. An expressive flake blend. A softer metallic surface. Explore 30 inspiration finishes and compare favourites in the floor studio.</p>
      <p>Your screen is a starting point, not a physical sample. Confirm available materials, texture, and the right coating system with Denis before choosing.</p>
    </ChapterReading>

    <div class="journey-breath" data-hall-from="finish-hall" data-hall-to="commercial" aria-hidden="true"></div>

    <section class="journey-chapter commercial-chapter" id="commercial" tabindex="-1" data-journey-chapter="commercial" aria-labelledby="commercial-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-commercial-poster.jpg" alt="" width="1280" height="720" decoding="async" />
      </div>
      <div class="chapter-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Commercial epoxy flooring</p>
        <h2 id="commercial-title" class="chapter-title">Built around your working day.</h2>
        </div>
      </div>
      <p class="chapter-index" data-act-label aria-hidden="true">08 / Commercial <span>Architectural concept</span></p>
    </section>

    <ChapterReading id="commercial" number="08" label="Plan around the working day" href="/services/commercial-epoxy-flooring" link="Explore commercial floors">
      <p>A shop floor, a showroom, a shared corridor. The right recommendation starts with how the space operates: traffic, cleaning, access, and the time you can set aside for installation.</p>
      <p>Discuss equipment, operating conditions, and areas that must remain accessible. Preparation and return-to-use requirements belong in the project conversation, not a blanket promise.</p>
    </ChapterReading>

    <ProjectStory story={projectStories[2]} />

    <FloorPlanning />

    <div class="journey-breath" data-hall-from="commercial" data-hall-to="consultation" aria-hidden="true"></div>

    <section class="journey-chapter consultation-chapter" id="consultation" tabindex="-1" data-journey-chapter="consultation" aria-labelledby="consultation-title">
      <div class="floor-film" aria-hidden="true">
        <img class="floor-film-poster" loading="lazy" src="/images/brand/epoxy-consultation-poster.jpg" alt="" width="1280" height="720" decoding="async" />
      </div>
      <div class="chapter-content consultation-content">
        <div class="chapter-copy-surface">
        <p class="eyebrow">Your next step</p>
        <h2 id="consultation-title" class="chapter-title">Let’s talk about your space.</h2>
        <div class="button-row">
          <a class="button button-primary" href="/floor-visualizer"><span>Preview a finish</span></a>
          <a class="button button-secondary" href="/contact#quote"><span>Request a quote</span></a>
        </div>
        <div class="trust-line">
          <p><a href="tel:+17809911651">Call Denis · (780) 991-1651</a><br /><a href="mailto:finalfinishepoxy@gmail.com">finalfinishepoxy@gmail.com</a></p>
        </div>
        </div>
      </div>
      <p class="chapter-index" data-act-label aria-hidden="true">10 / Talk to Denis</p>
    </section>

    <ChapterReading id="consultation" number="10" label="A useful first conversation" href="/contact#quote" link="Tell us about your project">
      <p>Tell Denis where the space is, how you use it, and what you would like to change. An approximate size and any concerns about the concrete help start a useful conversation.</p>
      <p>Preparation, repairs, finish choice, and access all shape the quote. Bring your questions and any shortlisted finishes; there is no need to have every detail worked out.</p>
    </ChapterReading>

    <div class="journey-breath journey-breath--end" aria-hidden="true"></div>
  </main>

  <SiteFooter />
</BaseLayout>
