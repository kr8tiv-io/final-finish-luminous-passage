---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MotionPreferenceControl from '../components/motion/MotionPreferenceControl';
import ReviewRing from '../components/home/ReviewRing.astro';
import GoogleMark from '../components/home/GoogleMark.astro';
import PreparationLayers from '../components/home/PreparationLayers.astro';
import FloorPlanning from '../components/home/FloorPlanning.astro';
import ProcessTrack from '../components/home/ProcessTrack.astro';
import FinishSamples from '../components/home/FinishSamples.astro';
import TransformationGallery from '../components/projects/TransformationGallery';
import ArchiveLattice from '../components/home/ArchiveLattice';
import customerProof from '../data/customer-proof.json';
import { ratingIsCurrent } from '../lib/content/review-navigation';
import {
  ARCHIVE_COLUMNS,
  ARCHIVE_JOB_COUNT,
  ARCHIVE_LEAD_INDEX,
  ARCHIVE_PHONE_COLUMNS,
  ARCHIVE_PHOTO_COUNT,
  ARCHIVE_ROWS,
  ARCHIVE_TILES,
  archiveResolveImage,
  archiveResolveIndex,
} from '../data/archive-lattice';
import '../styles/acts.css';

/*
 * The homepage, 2026-09-22 direction ("acts and paper", see src/styles/acts.css).
 *
 * Six acts — a film or a photograph held on screen while scroll tells its part — and
 * the white paper between them, on one grid, in one type pairing, with one motion
 * grammar (src/lib/motion/acts.ts). Every act opens out of paper mist and closes into
 * it, so an act and the paper after it are the same surface: nothing to seam.
 *
 * Retired from this page on Matt's review: the second reclaim room (the mancave film),
 * the resin headline pin (duplicated "Flake, solid, or metallic"), the "good
 * preparation shows" project story, the comparisons strip under the cylinder, the
 * per-act concept labels (one disclosure line now closes the page), and the empty
 * breaths between chapters.
 */
const title = 'Final Finish Epoxy | Edmonton Epoxy Floor Coatings';
const description = 'Edmonton epoxy floor coatings for garages, homes, and commercial rooms. Denis prepares the slab, then builds a flake, solid, or metallic finish. Free estimates.';
const { rating } = customerProof;
const currentRating = ratingIsCurrent(rating.verifiedAt, rating.refreshAfterDays);
const ratingDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(rating.verifiedAt));
const allowPending = import.meta.env.DEV || import.meta.env.SITE_ENV === 'staging';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <MotionPreferenceControl client:load />

  <main id="main-content" class="acts" data-acts>
    {/* ── Act 1 · The pour ─────────────────────────────────────────────────── */}
    <section id="portico" class="act act--hero" data-act="hero" style="--act-vh:235;--act-vh-phone:200" aria-labelledby="hero-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame">
            <picture>
              <source media="(max-width: 680px)" srcset="/images/brand/follow-floor/480/epoxy-pour-pearl-poster.jpg" />
              <img
                class="act-poster"
                loading="eager"
                fetchpriority="high"
                src="/images/brand/follow-floor/720/epoxy-pour-pearl-poster.jpg"
                srcset="/images/brand/follow-floor/480/epoxy-pour-pearl-poster.jpg 854w, /images/brand/follow-floor/720/epoxy-pour-pearl-poster.jpg 1280w, /images/brand/follow-floor/1080/epoxy-pour-pearl-poster.jpg 1920w"
                sizes="100vw"
                alt=""
                width="1280"
                height="720"
                decoding="async"
              />
            </picture>
            <video data-film="portico" data-film-window="0,0.9" muted playsinline disablepictureinpicture preload="none">
              <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-pour-pearl.mp4" type="video/mp4" />
              <source src="/videos/follow-floor/720/epoxy-pour-pearl.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="act-column" aria-hidden="true"></div>
        <div class="act-copy">
          <div class="act-copy-inner">
            <p class="t-kicker">Edmonton garage &amp; commercial floor coatings</p>
            <h1 id="hero-title" class="t-display">A better floor changes <em>the whole space.</em></h1>
            <p class="t-body">Epoxy floor coatings for Edmonton garages, workshops, and commercial spaces. Thoughtful preparation. A finish chosen around you.</p>
            <div class="button-row">
              <a class="button button-primary" href="/contact#quote"><span>Request a quote</span><span aria-hidden="true">↗</span></a>
              <a class="button button-secondary" href="/floor-visualizer"><span>Try your floor</span></a>
              <a class="text-call" href="tel:+17809911651">Call Denis <span>(780) 991-1651</span></a>
            </div>
            <a class="hero-proof" href="#customer-reviews">
              <GoogleMark />
              {currentRating
                ? <span><span class="hero-stars" aria-hidden="true">★★★★★</span> {rating.value.toFixed(1)} · {rating.count} reviews on Google</span>
                : <span>Hear from our customers</span>}
              {currentRating && <small>Checked {ratingDate}</small>}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── The proof, as a ring ─────────────────────────────────────────────── */}
    <ReviewRing />

    {/* ── Act 3 · Beneath the surface ──────────────────────────────────────── */}
    <section id="foundation" class="act" data-act="film" style="--act-vh:250;--act-vh-phone:215" aria-labelledby="foundation-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame">
            <img src="/images/brand/epoxy-walkway-pearl-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <video data-film="foundation" data-film-window="0.12,0.95" data-film-walk="true" muted playsinline disablepictureinpicture preload="none">
              <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-walkway-pearl.mp4" type="video/mp4" />
              <source src="/videos/follow-floor/720/epoxy-walkway-pearl.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <figure class="material-lens" data-material-lens aria-label="Midnight Aggregate flake finish, detail view">
          <div class="material-lens-glass"><img data-lens-pan src="/images/brand/texture/midnight-aggregate.webp" alt="Close view of a blue-black flake floor with pewter and pale chips under a clear coat" width="720" height="720" loading="lazy" decoding="async" /></div>
          <figcaption><span>Surface study</span><strong>Midnight Aggregate</strong></figcaption>
        </figure>
        <div class="act-copy">
          <div class="act-copy-inner">
            <p class="t-kicker">Preparation, repair, precision</p>
            <h2 id="foundation-title" class="t-title">The finish begins <em>below the surface.</em></h2>
          </div>
        </div>
        <div class="act-fog act-fog--rise" aria-hidden="true"></div>
        <div class="act-fog act-fog--in" aria-hidden="true"></div>
      </div>
    </section>

    <section id="foundation-details" class="sect reading-sect" aria-labelledby="foundation-reading">
      <div class="sect-inner reading">
        <div class="reading-label"><h3 id="foundation-reading" data-reveal="title">What happens beneath the finish</h3></div>
        <div class="reading-body">
          <p class="t-statement" data-reveal="fill">A beautiful finish starts with the concrete underneath.</p>
          <p class="t-body" data-reveal="fade">Discuss existing coatings, cracks, contamination, and moisture concerns with Denis before choosing a coating system. The assessment guides the preparation. It is the part you may not see in the finished photograph, but it deserves just as much attention.</p>
          <a class="link-quiet" href="/services/concrete-solutions" data-reveal="fade">Explore concrete preparation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="sect-inner prep-wrap">
        <PreparationLayers />
      </div>
    </section>

    {/* ── Act 4 · Reclaim: two rooms, one floor ────────────────────────────── */}
    <section id="reclaim" class="act act--bay" data-act="bay" style="--act-vh:320;--act-vh-phone:270" aria-labelledby="reclaim-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame act-room" id="garage">
            <img src="/images/brand/epoxy-garage-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <video data-film="garage" data-film-clock="held" data-film-window="0,0.5" muted playsinline disablepictureinpicture preload="none">
              <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-garage.mp4" type="video/mp4" />
              <source src="/videos/follow-floor/720/epoxy-garage.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="act-frame act-room" id="vault">
            <img src="/images/brand/epoxy-basement-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <video data-film="vault" data-film-clock="held" data-film-window="0.5,1" muted playsinline disablepictureinpicture preload="none">
              <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-basement.mp4" type="video/mp4" />
              <source src="/videos/follow-floor/720/epoxy-basement.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="act-copy">
          <div class="act-copy-inner">
            <p class="t-kicker">More room for your life</p>
            <h2 id="reclaim-title" class="t-title" data-car-title>Reclaim your <em>garage or basement.</em></h2>
            <div class="act-captions">
              <p class="act-caption"><strong>The workshop. The gym. The car you look after.</strong><span>Garage floors for vehicles, storage, equipment, and everyday use.</span></p>
              <p class="act-caption"><strong>A lounge below the house.</strong><span>Storage that became a room. A hobby space, a place to train, or simply a more useful basement.</span></p>
            </div>
          </div>
        </div>
        <div class="act-fog act-fog--rise" aria-hidden="true"></div>
        <div class="act-fog act-fog--in" aria-hidden="true"></div>
      </div>
    </section>

    <section id="reclaim-details" class="sect reading-sect" aria-labelledby="reclaim-reading">
      <div class="sect-inner reading">
        <div class="reading-label"><h3 id="reclaim-reading" data-reveal="title">Make room for what you love</h3></div>
        <div class="reading-body">
          <p class="t-statement" data-reveal="fill">The space was always there.</p>
          <p class="t-body" data-reveal="fade">A workshop for the weekend. A place to train. Space for a hobby that has outgrown the kitchen table. The floor is a sensible place to start making an underused room feel considered.</p>
          <p class="t-body" data-reveal="fade">Tell us what the space has to hold: vehicles, storage, equipment, or everyday use. That narrows the finish before anyone settles on a colour. A coating is one part of a room. It does not replace moisture remediation, ventilation, heating, or a full renovation.</p>
          <a class="link-quiet" href="/services/residential-epoxy-flooring" data-reveal="fade">Explore residential floors <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    {/* ── See the difference: the cylinder ─────────────────────────────────── */}
    <section id="proof" class="sect sect--examples" aria-labelledby="proof-title">
      <div class="sect-inner examples-head">
        <p class="t-kicker">Before and after</p>
        <h2 id="proof-title" class="t-title" data-reveal="title">See the <em>difference.</em></h2>
      </div>
      <TransformationGallery client:visible={{ rootMargin: '800px' }} head={false} explore={false} labelledBy="proof-title" allowPending={allowPending} />
    </section>

    {/* ── The archive wall ─────────────────────────────────────────────────── */}
    <section id="archive" class="archive-sect" data-archive-section aria-labelledby="archive-title">
      <ArchiveLattice
        client:visible={{ rootMargin: '900px' }}
        tiles={ARCHIVE_TILES}
        resolve={archiveResolveImage()}
        columns={ARCHIVE_COLUMNS}
        rows={ARCHIVE_ROWS}
        phoneColumns={ARCHIVE_PHONE_COLUMNS}
        leadIndex={ARCHIVE_LEAD_INDEX}
        resolveIndex={archiveResolveIndex()}
        photoCount={ARCHIVE_PHOTO_COUNT}
        jobCount={ARCHIVE_JOB_COUNT}
      />
    </section>

    {/* ── Act 7 · Your finish: the marbled walk, entered through poured resin ─ */}
    <section id="finish-hall" class="act" data-act="film" data-fog-in="resin" style="--act-vh:245;--act-vh-phone:210" aria-labelledby="finish-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame">
            <img src="/images/brand/epoxy-finish-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <video data-film="finish-hall" data-film-window="0.05,0.98" muted playsinline disablepictureinpicture preload="none">
              <source media="(max-width: 680px)" src="/videos/follow-floor/480/epoxy-finish.mp4" type="video/mp4" />
              <source src="/videos/follow-floor/720/epoxy-finish.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="act-copy act-copy--center">
          <div class="act-copy-inner">
            <p class="t-kicker">Flake, solid, and metallic</p>
            <h2 id="finish-title" class="t-title">Find your <em>finish.</em></h2>
            <div class="button-row">
              <a class="button button-secondary" href="/finishes"><span>Explore finishes</span></a>
              <a class="button button-primary" href="/floor-visualizer?from=finish-hall"><span>Make it yours</span><span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
        <div class="act-fog act-fog--rise" aria-hidden="true"></div>
        <div class="act-fog act-fog--in" aria-hidden="true"></div>
      </div>
    </section>

    <section id="finish-hall-details" class="sect reading-sect" aria-labelledby="finish-reading">
      <div class="sect-inner reading">
        <div class="reading-label"><h3 id="finish-reading" data-reveal="title">A finish, not just a colour</h3></div>
        <div class="reading-body">
          <p class="t-statement" data-reveal="fill">Quiet stone tones. An expressive flake blend. A softer metallic surface.</p>
          <p class="t-body" data-reveal="fade">Explore 30 inspiration finishes and compare favourites in the floor studio. Your screen is a starting point, not a physical sample. Confirm available materials, texture, and the right coating system with Denis before choosing.</p>
          <a class="link-quiet" href="/floor-visualizer?from=finish-hall" data-reveal="fade">Preview your own floor <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <FinishSamples />
    </section>

    {/* ── Act 8 · Commercial: the plate drifts, light travels the floor ────── */}
    <section id="commercial" class="act act--commercial" data-act="film" data-push="1.14" data-pan="5" style="--act-vh:225;--act-vh-phone:195" aria-labelledby="commercial-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame">
            <img src="/images/brand/epoxy-commercial-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <div class="act-sheen"></div>
          </div>
        </div>
        <div class="act-copy">
          <div class="act-copy-inner">
            <p class="t-kicker">Commercial epoxy flooring</p>
            <h2 id="commercial-title" class="t-title">Built around your <em>working day.</em></h2>
          </div>
        </div>
        <div class="act-fog act-fog--rise" aria-hidden="true"></div>
        <div class="act-fog act-fog--in" aria-hidden="true"></div>
      </div>
    </section>

    <section id="commercial-details" class="sect reading-sect" aria-labelledby="commercial-reading">
      <div class="sect-inner reading">
        <div class="reading-label"><h3 id="commercial-reading" data-reveal="title">Plan around the working day</h3></div>
        <div class="reading-body">
          <p class="t-statement" data-reveal="fill">A shop floor, a showroom, a shared corridor.</p>
          <p class="t-body" data-reveal="fade">The right recommendation starts with how the space operates: traffic, cleaning, access, and the time you can set aside for installation. Discuss equipment, operating conditions, and areas that must remain accessible. Preparation and return-to-use requirements belong in the project conversation, not a blanket promise.</p>
          <a class="link-quiet" href="/services/commercial-epoxy-flooring" data-reveal="fade">Explore commercial floors <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    {/* ── The process, sideways ────────────────────────────────────────────── */}
    <ProcessTrack />

    <FloorPlanning />

    {/* ── Act 10 · Talk to Denis ───────────────────────────────────────────── */}
    <section id="consultation" class="act act--last" data-act="film" style="--act-vh:190;--act-vh-phone:170" aria-labelledby="consultation-title">
      <div class="act-stage">
        <div class="act-plate" aria-hidden="true">
          <div class="act-frame">
            <img src="/images/brand/epoxy-consultation-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="act-copy act-copy--center">
          <div class="act-copy-inner">
            <p class="t-kicker">Your next step</p>
            <h2 id="consultation-title" class="t-title">Let’s talk about <em>your space.</em></h2>
            <div class="button-row">
              <a class="button button-primary" href="/contact#quote"><span>Request a quote</span><span aria-hidden="true">↗</span></a>
              <a class="button button-secondary" href="/floor-visualizer"><span>Preview a finish</span></a>
            </div>
            <p class="trust-line"><a href="tel:+17809911651">Call Denis · (780) 991-1651</a><span aria-hidden="true">·</span><a href="mailto:finalfinishepoxy@gmail.com">finalfinishepoxy@gmail.com</a></p>
          </div>
        </div>
        <div class="act-fog act-fog--rise" aria-hidden="true"></div>
        <div class="act-fog act-fog--in" aria-hidden="true"></div>
      </div>
    </section>

    <section id="consultation-details" class="sect reading-sect reading-sect--last" aria-labelledby="consultation-reading">
      <div class="sect-inner reading">
        <div class="reading-label"><h3 id="consultation-reading" data-reveal="title">A useful first conversation</h3></div>
        <div class="reading-body">
          <p class="t-statement" data-reveal="fill">Tell Denis where the space is, how you use it, and what you would like to change.</p>
          <p class="t-body" data-reveal="fade">An approximate size and any concerns about the concrete help start a useful conversation. Preparation, repairs, finish choice, and access all shape the quote. Bring your questions and any shortlisted finishes; there is no need to have every detail worked out.</p>
          <a class="link-quiet" href="/contact#quote" data-reveal="fade">Tell us about your project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { bindRouteScoped } from '../lib/motion/route-lifecycle';
  import { initActs } from '../lib/motion/acts';

  bindRouteScoped(initActs);
</script>
