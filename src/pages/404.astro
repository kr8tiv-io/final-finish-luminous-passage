---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InteriorHero from '../components/InteriorHero.astro';
import SectionShell from '../components/SectionShell.astro';

// Rendered on demand, deliberately. @astrojs/node's standalone server serves a *prerendered*
// 404.html straight off disk for any unmatched path — before Astro's pipeline, so before
// `src/middleware.ts`. That silently turned the Step 30 permanent redirects (`/areas/<town>`
// → `/service-area`) into 404s once this page existed. Keeping the 404 route on demand sends
// every unmatched request through the middleware first (301 where a redirect is declared),
// and Astro still answers with an HTTP 404 status for this route.
export const prerender = false;
---

<BaseLayout
  title="Page Not Found | Final Finish Epoxy"
  description="This page does not exist on the Final Finish Epoxy site. Find services, projects, or contact Denis instead."
  canonicalPath="/404"
  noindex
>
  <SiteHeader />
  <main id="main-content">
    <InteriorHero
      eyebrow="404"
      title="That page is not here."
      lead="Try services, projects, or call Denis."
    />
    <SectionShell>
      <p class="section-kicker">Find your way back</p>
      <h2 class="section-title">A few places to start instead.</h2>
      <div class="button-row">
        <a class="button button-primary" href="/">Home</a>
        <a class="button button-secondary" href="/services">Services</a>
        <a class="button button-secondary" href="/projects">Projects</a>
        <a class="button button-secondary" href="/contact">Contact</a>
      </div>
    </SectionShell>
  </main>
  <SiteFooter />
</BaseLayout>
