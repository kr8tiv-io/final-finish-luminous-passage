---
import FloorVisualizer from '../components/visualizer/FloorVisualizer';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { finishPresets } from '../lib/visualizer/finishes';

/** The count renders from the finish data so the page cannot claim a stale number. */
const finishCount = finishPresets.length;
const title = 'Epoxy Floor Visualizer | Final Finish Epoxy Edmonton';
const description = `Try ${finishCount} epoxy-floor inspirations on a photo of your own garage or room. The preview runs on your device, and the next step is a free estimate from Denis.`;
---
<BaseLayout title={title} description={description} canonicalPath="/floor-visualizer" imagePath="/images/brand/luminous-finish-hall.jpg">
  <SiteHeader />
  <main id="main-content">
    <section class="visualizer-hero">
      <div class="visualizer-intro">
        <div>
          <p class="eyebrow">The Finish Studio · Edmonton</p>
          <!-- The line mask splits this heading; the label keeps one stable accessible name. -->
          <h1 aria-label="Your space. A new surface.">Your space.<br />A new surface.</h1>
        </div>
        <p>Try {finishCount} finish inspirations. Add your room, mark where the floor is, and compare your favourites. Your photo stays on this device unless you choose to send it.</p>
      </div>
    </section>
    <FloorVisualizer client:load />
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .visualizer-hero { padding: clamp(7rem,11vw,10rem) var(--gutter) 3rem; }
  .visualizer-intro { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 3rem; width: min(100%,1450px); margin: auto; }
  .eyebrow { font-size: .65rem; letter-spacing: .13em; margin-bottom: 1.25rem; }
  .visualizer-intro h1 { margin: 0; font-family: var(--sans); font-size: clamp(2.8rem,5.5vw,5.8rem); font-weight: 470; letter-spacing: -.065em; line-height: 1.04; }
  .visualizer-intro > p { max-width: 29rem; margin: 0 0 .35rem; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  @media(max-width:700px) {
    .visualizer-hero { padding: 6rem var(--gutter) 1.8rem; }
    .visualizer-intro { grid-template-columns: 1fr; gap: 1.25rem; }
    .visualizer-intro h1 { font-size: clamp(2.65rem,10vw,4rem); }
    .visualizer-intro > p { font-size: .85rem; line-height: 1.65; }
  }
</style>
