---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InteriorHero from '../components/InteriorHero.astro';
import SectionShell from '../components/SectionShell.astro';

const steps = [
  { title: 'Inspect the slab', copy: 'Condition, oil, old coating, cracks, moisture clues, and how the room is used. Google reviewers keep pointing at this step because it is the job.' },
  { title: 'Grind and repair', copy: 'Diamond grinding opens the surface. Cracks and pits get patched before anything decorative goes down.' },
  { title: 'Build the system', copy: 'Primer where the slab needs it, then flake, solid, or metallic—matched to the space, not a catalogue promise.' },
  { title: 'Cove and topcoat', copy: 'Edges and a wear layer that can take tires, salt melt, and cleaning. The finish is the last coat, not the only coat.' },
  { title: 'Hand it back', copy: 'Denis stays on the job. Timing is quoted up front. Drive-on windows depend on the system and the weather that week—confirmed in the quote, not guessed here.' },
];
---

<BaseLayout title="How an Epoxy Floor Gets Built | Final Finish Edmonton" description="Inspect, grind, repair, coat, cove, and topcoat. How Final Finish Epoxy actually builds a garage or shop floor in Edmonton." canonicalPath="/process" imagePath="/images/brand/foundation-chamber.jpg">
  <SiteHeader />
  <main id="main-content">
    <InteriorHero eyebrow="The sequence" title="How a floor actually goes." lead="Reviewers keep saying the same thing: Denis is on the job, the prep is real, and the floor shows it. This is the order of work." />
    <SectionShell>
      <ol class="process-steps">
        {steps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{step.title}</h2>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>
      <div class="button-row">
        <a class="button button-primary" href="/contact#quote">Tell Denis about the slab</a>
        <a class="button button-secondary" href="/projects">See the work</a>
      </div>
    </SectionShell>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .process-steps { display: grid; gap: 2rem; margin: 0; padding: 0; list-style: none; }
  .process-steps li { display: grid; gap: 0.6rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .process-steps span { color: var(--cobalt); font-size: 0.7rem; font-weight: 780; letter-spacing: 0.14em; }
  .process-steps h2 { margin: 0; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 400; }
  .process-steps p { margin: 0; max-width: 40rem; color: var(--muted); }
</style>
