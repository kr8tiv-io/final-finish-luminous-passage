---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/readable-experience.css';
import '../styles/surface.css';
import '../styles/route-transitions.css';
import SurfaceCanvas from '../components/motion/SurfaceCanvas';
import { deploymentSettings } from '../lib/deployment.js';
import { buildSiteGraph } from '../lib/seo/schema';
import { buildBreadcrumbList } from '../lib/seo/breadcrumbs';
import { resolveSocialImage } from '../lib/seo/meta';

/**
 * The route transition, and why it lives in the layout.
 *
 * `<ClientRouter />` turns every same-origin link into a swap of this document's
 * body rather than a new document, which is what removes the white frame between
 * routes: the paper the visitor is already looking at is never torn down, only
 * wiped. Two things cross that swap untouched — the header and the one WebGL
 * context — because both carry `transition:persist` below, and
 * `src/lib/motion/route-lifecycle.ts` is the single owner of everything that has to
 * stop, restart or be re-pointed around them.
 *
 * The wipe itself is CSS, in `src/styles/route-transitions.css`: a warm-white
 * (#FAF9F6) sheet with an uneven resin edge crossing the viewport in 520 ms on
 * power2.inOut, and a 200 ms cross-fade when motion is refused.
 *
 * Prefetch arrives with the router — it initialises with `{ prefetchAll: true }` and
 * the config default strategy `hover` — and `SiteHeader.astro` states `hover` on the
 * primary links in markup so the intent survives a future `prefetchAll: false`.
 *
 * @motion page-wipe
 */

/**
 * The font preload in `<head>`, and why there is exactly one.
 *
 * Step 13 self-hosts Manrope as a single latin-subset variable woff2 at
 * `public/fonts/manrope-latin-var.woff2` (24.8 KB). Serving it from `public/`
 * rather than importing the npm package is what makes it preloadable at all: an
 * imported font is Vite-hashed build output, so no static `<link>` can name it,
 * and the browser discovers it only after the stylesheet has parsed. The href
 * below and the `@font-face` `src` in `src/styles/global.css` are the same
 * string, so the two resolve to one request.
 *
 * `crossorigin` is not optional even though the file is same-origin: a font
 * fetch driven by CSS is always CORS-mode anonymous, and a preload without the
 * attribute does not match it — the file downloads twice. A second preload of
 * any kind would take the bandwidth this one is buying, so
 * `tests/e2e/typography.spec.ts` asserts the count is exactly one and that
 * `document.fonts` reports Manrope loaded from this URL.
 */

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  imagePath?: string;
  /**
   * Extra JSON-LD node(s) for this specific page (e.g. a `Service` block on a services page).
   * Rendered as-is, each in its own <script type="application/ld+json">, alongside the
   * site-wide business/website graph and the auto-derived BreadcrumbList this layout already
   * emits — a page should never need to hand-roll those two itself.
   */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex,
  imagePath,
  jsonLd,
} = Astro.props;

const deployment = deploymentSettings(import.meta.env.SITE_ENV, Astro.site);
const shouldNoindex = deployment.noindex || noindex === true;
const siteUrl = deployment.site;
const canonical = new URL(canonicalPath, deployment.canonicalOrigin);
const businessId = new URL('/#business', deployment.canonicalOrigin).toString();
const websiteId = new URL('/#website', siteUrl).toString();
const logoUrl = new URL('/icons/icon-512.png', siteUrl).toString();
const socialImage = await resolveSocialImage(canonicalPath, siteUrl, imagePath);
const siteSchema = buildSiteGraph({ businessId, websiteId, siteUrl: siteUrl.toString(), logoUrl, imageUrl: socialImage.url.toString() });
const breadcrumbSchema = buildBreadcrumbList(deployment.canonicalOrigin, canonicalPath, title);
const extraJsonLd = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<!-- `data-environment` is the same staging-only switch `SurfaceCanvas`'s `probe` prop
     rides on, hoisted to the document so a module script can read it without
     `define:vars` (which would force `is:inline` and lose the import). It gates
     `window.__ffeRoute`, the route lifecycle's read-only diagnostics. -->
<html lang="en-CA" data-environment={deployment.environment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf9f6" />
    <!-- The one font file the site loads. See the Step 13 note above. -->
    <link
      rel="preload"
      href="/fonts/manrope-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- The display face every title is set in (global.css). Preloaded so the first
         title paints in Cormorant rather than swapping from its Georgia stand-in. -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Final Finish Epoxy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content="Final Finish Epoxy — a luminous architectural floor concept" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.url} />
    <script is:inline type="application/ld+json" data-site-schema set:html={JSON.stringify(siteSchema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" data-breadcrumb-schema set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraJsonLd.map((node) => <script is:inline type="application/ld+json" data-page-schema set:html={JSON.stringify(node)} />)}
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <!-- The one floor: a CSS band on balanced/still tiers, and the WebGL view's
         rectangle when SurfaceCanvas is admitted. See src/styles/surface.css.
         Persisted with the canvas, not separately: it is the `surface-floor` view's
         rectangle, and a canvas that survived a swap pointing at a band that did not
         would draw the floor into a detached node's zero-sized rect. -->
    <div
      class="surface-band"
      data-surface-fallback
      data-surface-state="2"
      aria-hidden="true"
      transition:persist="surface-band"
    ></div>
    <SurfaceCanvas
      client:idle={{ timeout: 2000 }}
      probe={deployment.environment !== 'production'}
      transition:persist="site-surface"
    />
    <slot />
    <script>
      import { initializeRouteLifecycle } from '../lib/motion/route-lifecycle';
      // A bundled module script: it runs once for the session, which is exactly the
      // lifetime the document listeners want.
      initializeRouteLifecycle();
    </script>
  </body>
</html>
