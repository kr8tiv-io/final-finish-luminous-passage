---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/readable-experience.css';
import '../styles/surface.css';
import '../styles/route-transitions.css';
import SurfaceCanvas from '../components/motion/SurfaceCanvas';
import { deploymentSettings } from '../lib/deployment.js';

/**
 * The route transition, and why it lives in the layout.
 *
 * `<ClientRouter />` turns every same-origin link into a swap of this document's
 * body rather than a new document, which is what removes the white frame between
 * routes: the paper the visitor is already looking at is never torn down, only
 * wiped. Two things cross that swap untouched — the header and the one WebGL
 * context — because both carry `transition:persist` below, and
 * `src/lib/motion/route-lifecycle.ts` is the single owner of everything that has to
 * stop, restart or be re-pointed around them.
 *
 * The wipe itself is CSS, in `src/styles/route-transitions.css`: a warm-white
 * (#FAF9F6) sheet with an uneven resin edge crossing the viewport in 520 ms on
 * power2.inOut, and a 200 ms cross-fade when motion is refused.
 *
 * Prefetch arrives with the router — it initialises with `{ prefetchAll: true }` and
 * the config default strategy `hover` — and `SiteHeader.astro` states `hover` on the
 * primary links in markup so the intent survives a future `prefetchAll: false`.
 *
 * @motion page-wipe
 */

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  imagePath?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex,
  imagePath = '/images/brand/final-finish-epoxy-og.jpg',
} = Astro.props;

const deployment = deploymentSettings(import.meta.env.SITE_ENV, Astro.site);
const shouldNoindex = deployment.noindex || noindex === true;
const siteUrl = deployment.site;
const canonical = new URL(canonicalPath, deployment.canonicalOrigin);
const socialImage = new URL(imagePath, siteUrl);
const businessId = new URL('/#business', deployment.canonicalOrigin).toString();
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeAndConstructionBusiness',
      '@id': businessId,
      name: 'Final Finish Epoxy',
      url: siteUrl.toString(),
      logo: new URL('/favicon.svg', siteUrl).toString(),
      image: socialImage.toString(),
      telephone: '+1-780-991-1651',
      email: 'finalfinishepoxy@gmail.com',
      areaServed: [
        { '@type': 'City', name: 'Edmonton' },
        { '@type': 'City', name: 'Sherwood Park' },
        { '@type': 'City', name: 'St. Albert' },
        { '@type': 'City', name: 'Leduc' },
        { '@type': 'City', name: 'Fort Saskatchewan' },
        { '@type': 'City', name: 'Spruce Grove' },
        { '@type': 'City', name: 'Beaumont' },
      ],
      sameAs: [
        'https://www.facebook.com/profile.php?id=61573826827114',
        'https://www.instagram.com/final_finish_epoxy/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteUrl).toString(),
      url: siteUrl.toString(),
      name: 'Final Finish Epoxy',
      inLanguage: 'en-CA',
      publisher: { '@id': businessId },
    },
  ],
};
---

<!doctype html>
<!-- `data-environment` is the same staging-only switch `SurfaceCanvas`'s `probe` prop
     rides on, hoisted to the document so a module script can read it without
     `define:vars` (which would force `is:inline` and lose the import). It gates
     `window.__ffeRoute`, the route lifecycle's read-only diagnostics. -->
<html lang="en-CA" data-environment={deployment.environment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Final Finish Epoxy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Final Finish Epoxy — a luminous architectural floor concept" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" data-site-schema set:html={JSON.stringify(siteSchema)} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <!-- The one floor: a CSS band on balanced/still tiers, and the WebGL view's
         rectangle when SurfaceCanvas is admitted. See src/styles/surface.css.
         Persisted with the canvas, not separately: it is the `surface-floor` view's
         rectangle, and a canvas that survived a swap pointing at a band that did not
         would draw the floor into a detached node's zero-sized rect. -->
    <div
      class="surface-band"
      data-surface-fallback
      data-surface-state="2"
      aria-hidden="true"
      transition:persist="surface-band"
    ></div>
    <SurfaceCanvas
      client:idle={{ timeout: 2000 }}
      probe={deployment.environment !== 'production'}
      transition:persist="site-surface"
    />
    <slot />
    <script>
      import { initializeRouteLifecycle } from '../lib/motion/route-lifecycle';
      // A bundled module script: it runs once for the session, which is exactly the
      // lifetime the document listeners want.
      initializeRouteLifecycle();
    </script>
  </body>
</html>
