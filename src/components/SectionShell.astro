---
/**
 * A paper section on an interior page, in the homepage's language (2026-09-22): printed
 * on the site's paper and grid (transparent, see design-system.css), a kicker in the
 * italic display face, titles in display caps. `page-motion.ts` brings each piece in
 * with the shared vocabulary (reveal.ts).
 */
interface Props { tone?: 'paper' | 'stone' | 'blue'; }
const { tone = 'paper' } = Astro.props;
---
<section class:list={['section-shell', `tone-${tone}`]}><div class="section-inner"><slot /></div></section>
<style>
  .section-shell { position: relative; padding: clamp(5.5rem, 10vw, 9.5rem) var(--gutter); }
  .section-inner { width: min(100%, var(--max)); margin: 0 auto; }
  .tone-paper { background: transparent; }
  .tone-stone { background: linear-gradient(rgb(var(--paper-rgb) / 0), rgb(237 234 227 / .72) 30%, rgb(237 234 227 / .72) 70%, rgb(var(--paper-rgb) / 0)); }
  .tone-blue { background: var(--ink); color: var(--paper-bright); }
  .tone-blue :global(:is(.section-title, h2, h3)) { color: var(--paper-bright); }
  .tone-blue :global(.section-title em) { color: var(--cobalt-light); }
  :global(.section-kicker) { display: flex; align-items: center; gap: .9rem; margin: 0 0 1.3rem; color: var(--cobalt); font-family: var(--display); font-style: italic; font-weight: 400; font-size: var(--t-kicker); letter-spacing: 0; text-transform: none; }
  :global(.section-kicker)::before { content: ''; flex: 0 0 2.4rem; height: 1px; background: currentColor; opacity: .55; }
  :global(.section-title) { max-width: 16ch; }
  :global(.section-lead) { max-width: 62ch; color: var(--ink-body); font-size: clamp(1.05rem, 1.25vw, 1.25rem); line-height: 1.6; }
  /* Step 29: body paragraphs inside a shell keep the reading measure (`--measure-body`). */
  :global(.section-inner > p:not(.section-lead):not(.section-kicker)) { max-width: var(--measure-body); line-height: 1.7; }
  :global(.card-grid) { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: clamp(2rem,4vw,4rem); margin-top: 3.5rem; }
  :global(.editorial-card) { padding: 1.6rem 0 0; border-top: 1px solid rgb(var(--ink-rgb) / .16); background: transparent; }
  :global(.editorial-card :is(h2, h3)) { margin: 0 0 1rem; font-family: var(--display); font-weight: 500; font-size: var(--t-h3); line-height: 1.02; letter-spacing: .004em; text-transform: uppercase; }
  :global(.editorial-card p) { color: var(--ink-body); font-size: var(--type-body); line-height: 1.7; }
  :global(.editorial-card a) { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; color: var(--cobalt); font-size: .74rem; font-weight: 650; letter-spacing: .14em; text-transform: uppercase; text-underline-offset: .45rem; }
  @media (max-width: 820px) { :global(.card-grid) { grid-template-columns: 1fr; } }
</style>
