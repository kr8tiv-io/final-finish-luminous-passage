---
interface Props { tone?: 'paper' | 'stone' | 'blue'; }
const { tone = 'paper' } = Astro.props;
---
<section class:list={['section-shell', `tone-${tone}`]}><div class="section-inner"><slot /></div></section>
<style>
  .section-shell { padding: clamp(5rem, 10vw, 9rem) var(--gutter); }
  .section-inner { width: min(100%, var(--max)); margin: 0 auto; }
  .tone-paper { background: #fbfaf5; }
  .tone-stone { background: #ded8cd; }
  .tone-blue { background: #173d59; color: white; }
  :global(.section-kicker) { color: var(--cobalt); font-size: .7rem; font-weight: 780; letter-spacing: .16em; text-transform: uppercase; }
  :global(.section-title) { max-width: 12ch; margin: 0; font-family: var(--serif); font-size: clamp(3rem, 5.6vw, 6.4rem); font-weight: 400; letter-spacing: -.044em; line-height: .92; }
  :global(.section-lead) { max-width: 42rem; color: var(--muted); font-size: 1.08rem; }
  :global(.card-grid) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 3rem; background: var(--line); border: 1px solid var(--line); }
  :global(.editorial-card) { padding: clamp(1.5rem, 3vw, 3rem); background: #fbfaf5; }
  :global(.editorial-card h2), :global(.editorial-card h3) { margin: 0 0 1rem; font-family: var(--serif); font-size: 2rem; font-weight: 400; line-height: 1; }
  :global(.editorial-card p) { color: var(--muted); }
  :global(.editorial-card a) { color: var(--cobalt-dark); font-size: .72rem; font-weight: 780; letter-spacing: .08em; text-underline-offset: .35rem; text-transform: uppercase; }
  @media (max-width: 820px) { :global(.card-grid) { grid-template-columns: 1fr; } }
</style>
