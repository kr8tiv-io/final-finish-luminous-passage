---
interface Props { tone?: 'paper' | 'stone' | 'blue'; }
const { tone = 'paper' } = Astro.props;
---
<section class:list={['section-shell', `tone-${tone}`]}><div class="section-inner"><slot /></div></section>
<style>
  .section-shell { padding: var(--reading-space) var(--gutter); }
  .section-inner { width: min(100%, var(--max)); margin: 0 auto; }
  .tone-paper { background: var(--paper); }
  .tone-stone { background: linear-gradient(var(--paper),#edeae3 40%,var(--paper)); }
  .tone-blue { background: #173d59; color: white; }
  :global(.section-kicker) { color: var(--cobalt); font-size: .875rem; font-weight: 650; letter-spacing: .075em; text-transform: uppercase; }
  :global(.section-title) { max-width: 16ch; margin: 0; font: 550 var(--type-chapter)/1.08 var(--sans); letter-spacing: -.025em; text-wrap: balance; }
  :global(.section-lead) { max-width: 62ch; color: #3f4e57; font-size: var(--type-lead); line-height: 1.5; }
  :global(.card-grid) { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: clamp(2rem,4vw,4rem); margin-top: 3rem; }
  :global(.editorial-card) { padding: 1.5rem 0; border-top: 1px solid var(--line); background: transparent; }
  :global(.editorial-card h2), :global(.editorial-card h3) { margin: 0 0 1rem; font: 550 clamp(1.5rem,2.4vw,2rem)/1.2 var(--sans); letter-spacing: -.02em; }
  :global(.editorial-card p) { color: #3f4e57; font-size: var(--type-body); line-height: 1.65; }
  :global(.editorial-card a) { display: inline-flex; align-items: center; min-height: 44px; color: var(--cobalt-dark); font-size: .875rem; font-weight: 650; text-underline-offset: .35rem; }
  @media (max-width: 820px) { :global(.card-grid) { grid-template-columns: 1fr; } }
</style>
