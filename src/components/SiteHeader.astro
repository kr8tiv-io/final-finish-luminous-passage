---
import '../styles/header-ribbon.css';
import '../styles/intent-motion.css';
const currentPath = Astro.url.pathname;
const links = [
  { href: '/services', label: 'Services' },
  { href: '/services/commercial-epoxy-flooring', label: 'Commercial' },
  { href: '/projects', label: 'Projects' },
  { href: '/finishes', label: 'Finishes' },
  { href: '/floor-visualizer', label: 'See your floor' },
  { href: '/resources', label: 'Resources' },
];
const currentHref = links.filter(link => currentPath === link.href || currentPath.startsWith(`${link.href}/`)).sort((a,b)=>b.href.length-a.href.length)[0]?.href;
---

<header class="site-header" data-site-header>
  <a class="brand" href="/" aria-label="Final Finish Epoxy home">
    <img class="brand-mark" src="/images/brand/final-finish-epoxy-mark.png" alt="" width="67" height="52" />
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
    <span class="sr-only">Open primary menu</span>
    <span aria-hidden="true">Menu</span>
  </button>

  <nav id="primary-navigation" aria-label="Primary navigation" data-primary-navigation>
    <span class="nav-material" data-nav-highlight aria-hidden="true"></span>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={currentHref === link.href ? 'page' : undefined}>
            <span class="nav-label-window"><span class="nav-label">{link.label}</span><span class="nav-label-echo" aria-hidden="true">{link.label}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <a class="header-phone" href="tel:+17809911651">Call (780) 991-1651</a>
  <a class="header-cta" href="/contact#quote">Talk to Denis</a>
  <div class="header-progress" aria-hidden="true"><span data-header-progress></span></div>
</header>

<script>
  import { initializeHeaderRibbon } from '../scripts/header-ribbon';
  import { initializeIntentMotion } from '../scripts/intent-motion';
  const disposeIntent = initializeIntentMotion();
  document.addEventListener('astro:before-swap', disposeIntent, {once:true});
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = header?.querySelector<HTMLElement>('[data-primary-navigation]');

  if (header && toggle && navigation) {
    const disposeRibbon = initializeHeaderRibbon(header, navigation);
    document.addEventListener('astro:before-swap', disposeRibbon, {once:true});
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.sr-only')!.textContent = open ? 'Close primary menu' : 'Open primary menu';
      header.toggleAttribute('data-menu-open', open);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
      if (!open) navigation.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
    navigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
