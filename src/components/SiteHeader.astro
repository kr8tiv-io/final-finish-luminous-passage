---
import '../styles/header-ribbon.css';
import '../styles/intent-motion.css';
import NavMenu from './nav/NavMenu.astro';
import { NAV_DESTINATIONS, navIndexLabel } from './nav/nav-destinations';
const currentPath = Astro.url.pathname;
const links = NAV_DESTINATIONS;
const currentHref = links.filter(link => currentPath === link.href || currentPath.startsWith(`${link.href}/`)).sort((a,b)=>b.href.length-a.href.length)[0]?.href;
---

{/* Persisted across route swaps (BaseLayout's <ClientRouter />), so the header the
    visitor is looking at is never rebuilt — the nav's highlight, the menu's warm-up
    and the progress rule all carry over. What does NOT carry over is anything the
    server rendered *for the outgoing route*: `aria-current` and the route hook are
    re-derived by `syncHeaderRoute` on `astro:after-swap`, before the new page paints. */}
<header class="site-header" data-site-header data-route={currentPath === '/' ? 'home' : (currentPath.split('/').filter(Boolean)[0] ?? 'home')} transition:persist="site-header">
  <a class="brand" href="/" aria-label="Final Finish Epoxy home">
    <img class="brand-mark" src="/images/brand/final-finish-epoxy-mark.png" alt="" width="67" height="52" />
  </a>

  <nav id="primary-navigation" aria-label="Primary navigation" data-primary-navigation>
    <span class="nav-material" data-nav-highlight aria-hidden="true"></span>
    <ul>
      {links.map((link, index) => (
        <li style={`--nav-depth:${(0.4 + index * 0.14).toFixed(2)}`}>
          <a
            href={link.href}
            data-astro-prefetch="hover"
            data-nav-finish={link.finish}
            aria-current={currentHref === link.href ? 'page' : undefined}
          >
            <span class="nav-label-window" data-nav-flip><span class="nav-label">{link.label}</span><span class="nav-label-echo" aria-hidden="true">{link.label}</span></span>
          </a>
          <span class="nav-index" data-nav-index aria-hidden="true">{navIndexLabel(index)}</span>
          <span class="nav-station" data-nav-station aria-hidden="true">{link.station}</span>
          <span class="nav-dot" data-nav-dot aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </nav>

  <div class="header-actions">
    <a class="header-phone" href="tel:+17809911651">Call (780) 991-1651</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="sr-only">Open primary menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span aria-hidden="true">Menu</span>
    </button>
    <a class="header-cta" href="/contact#quote">Talk to Denis</a>
  </div>
  <div class="header-progress" aria-hidden="true"><span data-header-progress></span></div>
</header>

<NavMenu />

<noscript>
  <style is:inline>
    .journey-motion-control { display: none; }
    body .site-header .menu-toggle { display: none; }
    body .site-header [data-primary-navigation] { position: static; display: block; visibility: visible; width: auto; padding: 0; border: 0; transform: none; pointer-events: auto; }
    body .site-header [data-primary-navigation] ul { display: flex; flex-wrap: wrap; }
    body .site-header [data-primary-navigation] li { grid-area: auto; }
    @media (max-width: 1100px) {
      body .site-header { position: relative; grid-template-columns: 1fr auto; }
      body .site-header .header-cta { grid-column: 2; grid-row: 1; }
      body .site-header [data-primary-navigation] { grid-column: 1 / -1; padding: .5rem 0; }
      body .site-header [data-primary-navigation] ul { display: grid; grid-template-columns: 1fr 1fr; }
      body .site-header [data-primary-navigation] a { min-height: 44px; }
    }
  </style>
</noscript>

<script>
  import { bindRouteScoped, onRouteSwap } from '../lib/motion/route-lifecycle';
  import { initializeHeaderRibbon, syncHeaderRoute } from '../scripts/header-ribbon';
  import { initializeIntentMotion } from '../scripts/intent-motion';
  import { initializeNavMenu } from './nav/nav-menu-controller';

  /**
   * This is a bundled module script, so it runs once per session and never again
   * after a swap. Everything it builds is therefore route-scoped through
   * `route-lifecycle.ts` rather than built inline: the ribbon measures `#portico`
   * and the page's own scroll height, the glint attaches itself to the page's
   * links, and the menu controller holds the overlay — none of which belong to the
   * document the visitor is on a moment later.
   */
  onRouteSwap(() => syncHeaderRoute());
  syncHeaderRoute();

  bindRouteScoped(() => {
    const disposeIntent = initializeIntentMotion();
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const navigation = header?.querySelector<HTMLElement>('[data-primary-navigation]');
    if (!header || !toggle || !navigation) return disposeIntent;
    const disposeRibbon = initializeHeaderRibbon(header, navigation);
    const disposeMenu = initializeNavMenu(header, toggle, navigation);
    return () => { disposeMenu(); disposeRibbon(); disposeIntent(); };
  });
</script>
