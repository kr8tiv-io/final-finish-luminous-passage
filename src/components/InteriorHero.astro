---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  chapter?: string;
}

const { eyebrow, title, lead, chapter = 'Final Finish · Edmonton' } = Astro.props;
---

<section class="interior-hero">
  <div class="interior-frame" aria-hidden="true"></div>
  <div class="interior-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
  <span class="interior-chapter" aria-hidden="true">{chapter}</span>
</section>

<style>
  .interior-hero { position: relative; display: grid; align-items: end; min-height: 70svh; padding: 11rem var(--gutter) var(--reading-space); overflow: hidden; background: linear-gradient(180deg,transparent 50%,var(--paper)), radial-gradient(ellipse at 82% 25%,rgba(111,166,202,.13),transparent 56%), var(--paper); }
  .interior-frame { position: absolute; top: 9rem; right: 7vw; bottom: 0; width: min(36vw, 36rem); border: 1px solid rgba(22,79,131,.09); border-bottom: 0; border-radius: 50% 50% 0 0 / 18% 18% 0 0; mask-image: linear-gradient(#000,transparent 90%); }
  .interior-copy { position: relative; z-index: 2; width: min(100%, var(--max)); margin: 0 auto; }
  .interior-copy h1 { max-width: 15ch; margin: 0; font: 550 var(--type-hero)/1.02 var(--sans); letter-spacing: -.035em; text-wrap: balance; overflow-wrap: break-word; }
  .interior-copy > p:last-child { max-width: 55ch; margin: 2rem 0 0; color: #3f4e57; font-size: var(--type-lead); line-height: 1.5; }
  .interior-chapter { position: absolute; right: var(--gutter); bottom: 2rem; color: var(--muted); font-size: .875rem; letter-spacing: .025em; }
  @media (max-width: 720px) { .interior-hero { min-height: 72svh; } .interior-frame { right: -18%; width: 70vw; opacity: .7; } }
</style>
