---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  chapter?: string;
}

const { eyebrow, title, lead, chapter = 'Final Finish · Edmonton' } = Astro.props;
---

<section class="interior-hero">
  <div class="interior-frame" aria-hidden="true"></div>
  <div class="interior-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
  <span class="interior-chapter" aria-hidden="true">{chapter}</span>
</section>

<style>
  .interior-hero { position: relative; display: grid; align-items: end; min-height: 78svh; padding: 11rem var(--gutter) 5rem; overflow: hidden; background: radial-gradient(ellipse at 72% 18%, white, transparent 30%), linear-gradient(145deg, #faf8f1, #ddd7cc); }
  .interior-frame { position: absolute; top: 9rem; right: 7vw; bottom: 0; width: min(36vw, 36rem); border: 1px solid rgba(22,79,131,.15); border-bottom: 0; border-radius: 50% 50% 0 0 / 18% 18% 0 0; box-shadow: inset 0 0 6rem rgba(22,79,131,.08); }
  .interior-copy { position: relative; z-index: 2; width: min(100%, var(--max)); margin: 0 auto; }
  .interior-copy h1 { max-width: 12ch; margin: 0; font-family: var(--serif); font-size: clamp(4rem, 8.2vw, 9rem); font-weight: 400; letter-spacing: -.055em; line-height: .86; text-wrap: balance; }
  .interior-copy > p:last-child { max-width: 40rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.22rem); }
  .interior-chapter { position: absolute; right: var(--gutter); bottom: 2rem; color: var(--muted); font-size: .64rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  @media (max-width: 720px) { .interior-hero { min-height: 72svh; } .interior-frame { right: -18%; width: 70vw; opacity: .7; } }
</style>
