---
import { resolve } from 'node:path';
import '../styles/print.css';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { resourcePath } from '../lib/publishing.js';
import { deploymentSettings } from '../lib/deployment.js';
import { buildArticleSchema, buildFaqSchema } from '../lib/seo/schema';
import { getGitContentDates, reconcileArticleDates } from '../lib/seo/git-dates';
import { resolveSocialImage } from '../lib/seo/meta';

type Resource = CollectionEntry<'resources'>;
interface Props { entry: Resource; Content: any; related: Resource[]; }
const { entry, Content, related } = Astro.props as Props;
const { data } = entry;
const path = resourcePath(entry);
const deployment = deploymentSettings(import.meta.env.SITE_ENV, Astro.site);
const canonical = new URL(path, deployment.canonicalOrigin).toString();
const serviceTurn = {
  'epoxy-flooring': { href: '/services/residential-epoxy-flooring', label: 'Residential epoxy flooring' },
  'garage-floor-coatings': { href: '/services/residential-epoxy-flooring', label: 'Residential epoxy flooring' },
  'commercial-flooring': { href: '/services/commercial-epoxy-flooring', label: 'Commercial epoxy flooring' },
  'floor-repair': { href: '/services/concrete-solutions', label: 'Concrete preparation' },
  'concrete-polishing': { href: '/services/concrete-solutions', label: 'Concrete preparation' },
  'neutral-material-education': { href: '/finishes', label: 'Finish families we actually install' },
}[data.primaryService];

// `resources` frontmatter (src/content.config.ts) only has `updatedAt` — no created date — so
// `datePublished` is derived from this file's own git history instead of invented (see
// src/lib/seo/git-dates.ts). `entry.filePath`, set by the glob content loader, is
// project-root-relative, and Astro always builds/dev-serves with the project root as
// `process.cwd()`. If a draft is ever rendered before being committed, git has no history for it
// yet, so this falls back to the same `updatedAt` the frontmatter already carries — a real,
// human-set date, never a made-up one.
const absoluteSourcePath = entry.filePath ? resolve(process.cwd(), entry.filePath) : null;
const gitDates = absoluteSourcePath ? getGitContentDates(absoluteSourcePath) : null;
const frontmatterUpdatedAt = data.updatedAt.toISOString();
const datePublished = gitDates?.datePublished ?? frontmatterUpdatedAt;
// See reconcileArticleDates: this repo's frontmatter `updatedAt` can predate the file's actual
// first commit, which would otherwise publish a dateModified earlier than datePublished.
const { dateModified } = reconcileArticleDates(datePublished, frontmatterUpdatedAt);
// The same business @id, logo and social picture BaseLayout puts in the site graph.
const businessId = new URL('/#business', deployment.canonicalOrigin).toString();
const logoUrl = new URL('/icons/icon-512.png', deployment.site).toString();
const socialImage = await resolveSocialImage(path, deployment.site);
const articleSchema = buildArticleSchema({
  headline: data.title,
  description: data.description,
  canonicalUrl: canonical,
  datePublished,
  dateModified,
  businessId,
  logoUrl,
  imageUrl: socialImage.url.toString(),
  section: data.category.replace('-', ' '),
});
const faq = data.faq ?? [];
const faqSchema = buildFaqSchema(faq, canonical);
const pageSchema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<BaseLayout title={`${data.title} | Final Finish Epoxy`} description={data.description} canonicalPath={path} jsonLd={pageSchema}>
  <SiteHeader />
  <main id="main-content">
    <header class="article-hero">
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><strong>{data.category.replace('-', ' ')}</strong></nav>
      <p class="eyebrow">{data.category.replace('-', ' ')} · Edmonton floor library</p>
      <h1>{data.title}</h1>
      <p class="deck">{data.description}</p>
    </header>
    <div class="article-grid">
      <aside class="article-rail">
        <p>Updated<br /><time datetime={data.updatedAt.toISOString()}>{data.updatedAt.toLocaleDateString('en-CA', { dateStyle: 'long', timeZone: 'UTC' })}</time></p>
        <a href="/contact#quote">Ask Denis about your floor</a>
      </aside>
      <article class="article-body">
        <Content />
        {faq.length > 0 && (
          <section class="article-faq" aria-labelledby="questions">
            <h2 id="questions">Questions people ask</h2>
            <dl>
              {faq.map((item) => (
                <div>
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        {serviceTurn && <p class="service-turn"><a href={serviceTurn.href}>{serviceTurn.label}</a></p>}
      </article>
      <aside class="source-panel" aria-labelledby="sources">
        <p class="eyebrow">Primary references</p>
        <h2 id="sources">Sources and further reading</h2>
        <ul>{data.sources.map((source) => <li><a href={source.url} rel="noopener">{source.name}</a><span>{source.publisher}{source.note && ` · ${source.note}`}</span></li>)}</ul>
      </aside>
    </div>
    {related.length > 0 && <section class="related" aria-labelledby="related"><p class="eyebrow">Keep exploring</p><h2 id="related">Related floor guides</h2><div>{related.map((item) => <a href={resourcePath(item)}>{item.data.title}<span aria-hidden="true">↗</span></a>)}</div></section>}
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .article-hero { padding: clamp(9rem, 16vh, 13rem) var(--gutter) var(--reading-space); background: linear-gradient(180deg,transparent 40%,var(--paper)), radial-gradient(ellipse at 88% 16%, rgba(111,166,202,.15), transparent 55%),var(--paper); }
  .article-hero > * { width: min(100%, 68rem); margin-inline: auto; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; margin-bottom: 3rem !important; color: var(--muted); font-size: .875rem; }
  nav a { color: inherit; }
  .article-hero h1 { margin: .8rem 0 1.6rem; font: 500 clamp(3rem, 6.3vw, 7.2rem)/.94 var(--display); letter-spacing: -.004em; text-transform: uppercase; text-wrap: balance; overflow-wrap: break-word; }
  .deck { max-width: 58ch; margin-left: 0; color: #3f4e57; font-size: var(--type-lead); line-height: 1.5; }
  .article-grid { display: grid; grid-template-columns: minmax(12rem, .42fr) minmax(0, 1fr); gap: 3rem 6vw; width: min(calc(100% - 2 * var(--gutter)), var(--max)); margin: 0 auto; padding: clamp(4rem, 9vw, 9rem) 0; }
  .article-rail { position: sticky; top: 7rem; align-self: start; }
  .review-note { display: grid; gap: .55rem; padding: 1.15rem; border: 1px solid #e3d5aa; background: #fff8e3; color: #645a3d; font-size: .72rem; }
  .article-rail > p { margin: 2rem 0; color: var(--muted); font-size: .875rem; line-height: 1.65; }
  .article-rail > a { display: inline-flex; align-items: center; min-height: 44px; color: var(--cobalt); font-size: .875rem; font-weight: 650; text-underline-offset: .35rem; }
  .article-body { max-width: 65ch; font-size: var(--type-body); line-height: 1.65; overflow-wrap: break-word; }
  .article-body :global(h2) { margin: 4.4rem 0 1.1rem; font: 500 clamp(2rem,3.2vw,3.3rem)/1.06 var(--display); letter-spacing: .002em; text-wrap: balance; }
  .article-body :global(h3) { margin: 2.8rem 0 .8rem; font-size: 1.2rem; }
  .article-body :global(p), .article-body :global(li) { color: #3f4a50; }
  .article-body :global(a) { color: var(--cobalt-dark); text-underline-offset: .22rem; }
  .article-body :global(blockquote) { margin: 2rem 0; padding: 1rem 1.5rem; border-left: 3px solid var(--cobalt); background: #eef3f5; }
  .article-faq dl { display: grid; gap: 1.8rem; margin: 0; }
  .article-faq dt { font-family: var(--display); font-size: clamp(1.35rem, 1.9vw, 1.7rem); font-weight: 500; line-height: 1.2; color: var(--ink); }
  .article-faq dd { margin: .55rem 0 0; color: #3f4a50; }
  .service-turn { margin-top: 3rem; }
  .service-turn a { color: var(--cobalt-dark); font-size: .875rem; font-weight: 650; }
  .source-panel { grid-column: 2; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .source-panel h2, .related h2 { margin: .6rem 0 2rem; font: 500 clamp(2rem,3.4vw,3.6rem)/1 var(--display); letter-spacing: .002em; text-transform: uppercase; }
  .source-panel ul { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .source-panel li { display: grid; gap: .2rem; }
  .source-panel li a { color: var(--cobalt-dark); font-weight: 700; }
  .source-panel li span { color: var(--muted); font-size: .875rem; }
  .related { padding: clamp(4rem, 8vw, 8rem) var(--gutter); background: #173d59; color: white; }
  .related > * { width: min(100%, var(--max)); margin-inline: auto; }
  .related .eyebrow { color: #a7d2e8; }
  .related div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.2); }
  .related div a { display: flex; justify-content: space-between; min-height: 11rem; padding: 1.5rem; background: #173d59; color: white; font-family: var(--serif); font-size: 1.7rem; line-height: 1; text-decoration: none; }
  @media (max-width: 800px) { .article-grid { grid-template-columns: 1fr; } .article-rail { position: static; } .source-panel { grid-column: 1; } .related div { grid-template-columns: 1fr; } }
</style>
