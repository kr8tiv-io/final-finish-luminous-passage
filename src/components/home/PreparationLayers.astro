---
/**
 * Preparation layers — illustrative cross-section of a coated floor.
 * Motion id: `layered-scrub` (MOTION-VOCABULARY.md), mechanic decoded from
 * isladjan `abdyPBw` in CONTEXT-SHEET.md A4b: one ScrollTrigger per layer
 * group, each with a different scrub lag, so the stack moves as one body with
 * velocity-dependent separation. Geometry and captions are illustrative only —
 * no claim here traces to Denis or the live site beyond the generic system
 * order already described in the foundation chapter copy.
 */
import '../../styles/preparation-layers.css';
import PrepLayers3D from './PrepLayers3D';

// Isometric plate geometry. Front edge runs FX0 -> FX1; the depth vector
// (DX, DY) pushes the back edge up and to the right. Gaps between plates are
// wider than |DY| so no plate ever occludes the top face of the one below it.
const FX0 = 120;
const FX1 = 940;
const DX = 130;
const DY = -74;

const topFace = (y: number) => `${FX0},${y} ${FX1},${y} ${FX1 + DX},${y + DY} ${FX0 + DX},${y + DY}`;
/** Maps a square texture tile onto a top face: u along the front edge, v along the depth vector. */
const topTexture = (y: number) => `matrix(1 0 ${(DX / 820).toFixed(5)} ${(DY / 820).toFixed(5)} ${FX0} ${y})`;
/** The soft shadow a plate casts straight down onto the plate below it (light from the front left). */
const shadowFace = (y: number) => `${FX0 + 26},${y + 8} ${FX1 + 26},${y + 8} ${FX1 + DX + 18},${y + DY + 8} ${FX0 + DX + 18},${y + DY + 8}`;
/** A window reflected in the clear coat, lying on the top face toward the back. */
const reflection = (y: number) => {
  const at = (u: number, v: number) => `${(FX0 + u * (FX1 - FX0) + v * DX).toFixed(1)},${(y + v * DY).toFixed(1)}`;
  return `${at(0.18, 0.5)} ${at(0.46, 0.5)} ${at(0.5, 0.92)} ${at(0.22, 0.92)}`;
};const frontFace = (y: number, t: number) => `${FX0},${y} ${FX1},${y} ${FX1},${y + t} ${FX0},${y + t}`;
const sideFace = (y: number, t: number) => `${FX1},${y} ${FX1 + DX},${y + DY} ${FX1 + DX},${y + DY + t} ${FX1},${y + t}`;

const SLAB_Y = 700, SLAB_T = 140;
const PRIMER_Y = 520, PRIMER_T = 20;
const BASE_Y = 360, BASE_T = 36;
const TOP_Y = 190, TOP_T = 40;
// Framed so the assembled stack fills the box and the deepest arrival offset
// (+140) still lands inside it: no clipping, no protrusion over the captions.
const VIEW_BOX = '0 60 1160 884';

// Deterministic pseudo-random source: the broadcast must be identical on the
// server, in the client bundle, and in every screenshot comparison.
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(0x5eed10c);
// A real flake blend (2026-09-22, Matt: "more lifelike"): charcoal, graphite, grey,
// white and a little tan, in irregular 5-7 sided chips of mixed size, laid on the base
// coat's plane (foreshortened by the same depth vector as the plates).
const FLAKE_TONES = ['#2b3135', '#4d565b', '#7d858a', '#b8bcb9', '#f2f0ea', '#9f8b72'];
const FLAKE_WEIGHTS = [0.18, 0.2, 0.2, 0.16, 0.18, 0.08];
const pickTone = () => {
  let r = random();
  for (let i = 0; i < FLAKE_TONES.length; i += 1) {
    r -= FLAKE_WEIGHTS[i];
    if (r <= 0) return FLAKE_TONES[i];
  }
  return FLAKE_TONES[0];
};

const flakes = Array.from({ length: 230 }, () => {
  const u = 0.02 + random() * 0.96;
  const v = 0.03 + random() * 0.92;
  const x = Math.round((FX0 + u * (FX1 - FX0) + v * DX) * 10) / 10;
  const y = Math.round((BASE_Y + v * DY) * 10) / 10;
  // Nearer chips (small v) read a little larger; sizes skew small with a few big ones.
  const size = (3.2 + random() ** 2.4 * 9.5) * (1.18 - v * 0.36);
  const sides = 5 + Math.floor(random() * 3);
  const turn = random() * Math.PI * 2;
  const points = Array.from({ length: sides }, (_, i) => {
    const angle = turn + (i / sides) * Math.PI * 2 + (random() - 0.5) * 0.6;
    const radius = size * (0.55 + random() * 0.45);
    return `${(Math.cos(angle) * radius).toFixed(1)},${(Math.sin(angle) * radius).toFixed(1)}`;
  }).join(' ');
  return { x, y, points, rotate: Math.round(random() * 360), tone: pickTone() };
});
// Diamond-cup passes read as overlapping swirls across the slab's top face.
const swirls = Array.from({ length: 9 }, (_, index) => ({
  cx: 215 + index * 95,
  cy: 663 + (index % 3) * 9,
  rx: 70 - (index % 2) * 10,
  ry: 24 - (index % 2) * 4,
}));

// One crack, read across the slab's top face and down its front edge.
const CRACK_TOP = 'M 300,700 L 336,684 L 362,692 L 400,670 L 440,679 L 478,658 L 520,638';
const CRACK_FRONT = 'M 300,700 L 276,736 L 294,766 L 274,800 L 292,832';

const captions = [
  ['01', 'Slab', 'Bare concrete, read before anything is added.'],
  ['02', 'Grind', 'Diamond grinding opens the surface profile.'],
  ['03', 'Repair', 'Cracks and pits are filled back to level.'],
  ['04', 'Primer', 'A primer keys the system into the slab.'],
  ['05', 'Base coat', 'The base coat carries the colour.'],
  ['06', 'Flake', 'Flake is broadcast into the wet base.'],
  ['07', 'Clear coat', 'A clear coat seals the flake and takes the wear.'],
];
const layerIds = ['slab', 'grind', 'repair', 'primer', 'base', 'flakes', 'topcoat'];
---

<div class="prep-layers" data-prep-layers data-prep-motion="still">
  <div class="prep-layers-head">
    <p class="prep-eyebrow">Under the finish</p>
    <h3 class="prep-statement" data-prep-statement>Grind. Repair. Build.</h3>
    <p class="prep-lede">The part of the job you never see again, drawn in section.</p>
  </div>

  <div class="prep-layers-body">
    <div class="prep-stage" data-prep-stage>
    <div class="prep-figure" data-prep-figure>
      <svg class="prep-svg" viewBox={VIEW_BOX} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
        <defs>
          {/* Real material, laid in the plates' own plane: a square texture tile mapped
              onto the top face by the same depth vector the geometry uses, so the
              surface foreshortens exactly as the plate does. */}
          <pattern id="prep-slab-top" patternUnits="userSpaceOnUse" width="820" height="820" patternTransform={topTexture(SLAB_Y)}>
            <image href="/images/brand/texture/prep-slab.webp" width="820" height="820" preserveAspectRatio="none"></image>
          </pattern>
          <pattern id="prep-ground-top" patternUnits="userSpaceOnUse" width="820" height="820" patternTransform={topTexture(SLAB_Y)}>
            <image href="/images/brand/texture/prep-ground.webp" width="820" height="820" preserveAspectRatio="none"></image>
          </pattern>
          <pattern id="prep-flake-bed" patternUnits="userSpaceOnUse" width="820" height="820" patternTransform={topTexture(BASE_Y)}>
            <image href="/images/brand/texture/prep-scraped.webp" width="820" height="820" preserveAspectRatio="none"></image>
          </pattern>
          <pattern id="prep-cut" patternUnits="userSpaceOnUse" width="340" height="340">
            <image href="/images/brand/texture/prep-slab.webp" width="340" height="340" preserveAspectRatio="none"></image>
          </pattern>
          <linearGradient id="prep-slab-shade" gradientUnits="userSpaceOnUse" x1="0" y1={SLAB_Y} x2="0" y2={SLAB_Y + SLAB_T}>
            <stop offset="0" stop-color="#17222a" stop-opacity="0.1"></stop>
            <stop offset="1" stop-color="#17222a" stop-opacity="0.42"></stop>
          </linearGradient>
          <linearGradient id="prep-top-light" gradientUnits="userSpaceOnUse" x1={FX0} y1="0" x2={FX1 + DX} y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.16"></stop>
            <stop offset="0.55" stop-color="#ffffff" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#17222a" stop-opacity="0.12"></stop>
          </linearGradient>
          <linearGradient id="prep-dust" gradientUnits="userSpaceOnUse" x1="0" y1={SLAB_Y - 52} x2="0" y2={SLAB_Y}>
            <stop offset="0" stop-color="#f4f1ea" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#efe9dd" stop-opacity="0.82"></stop>
          </linearGradient>
          <linearGradient id="prep-base-top" gradientUnits="userSpaceOnUse" x1={FX0} y1="0" x2={FX1 + DX} y2="0">
            <stop offset="0" stop-color="#626b70"></stop>
            <stop offset="0.5" stop-color="#4c5459"></stop>
            <stop offset="1" stop-color="#3a4145"></stop>
          </linearGradient>
          <linearGradient id="prep-primer-top" gradientUnits="userSpaceOnUse" x1={FX0} y1="0" x2={FX1 + DX} y2="0">
            <stop offset="0" stop-color="#dcc28e" stop-opacity="0.62"></stop>
            <stop offset="0.6" stop-color="#c9a66a" stop-opacity="0.5"></stop>
            <stop offset="1" stop-color="#b08c52" stop-opacity="0.58"></stop>
          </linearGradient>
          <linearGradient id="prep-coat-top" gradientUnits="userSpaceOnUse" x1="0" y1={TOP_Y + DY} x2="0" y2={TOP_Y}>
            <stop offset="0" stop-color="#e9f1f6" stop-opacity="0.34"></stop>
            <stop offset="1" stop-color="#cfdde6" stop-opacity="0.2"></stop>
          </linearGradient>
          <linearGradient id="prep-gloss" gradientUnits="userSpaceOnUse" x1="330" y1="0" x2="600" y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0"></stop>
            <stop offset="0.46" stop-color="#ffffff" stop-opacity="0.9"></stop>
            <stop offset="0.56" stop-color="#ffffff" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
          </linearGradient>
          <filter id="prep-soft" x="-20%" y="-60%" width="140%" height="220%"><feGaussianBlur stdDeviation="13"></feGaussianBlur></filter>
          <filter id="prep-rag" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.07" numOctaves="2" seed="4" result="t"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="t" scale="7" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
          </filter>
          <clipPath id="prep-clip-slab-top"><polygon points={topFace(SLAB_Y)}></polygon></clipPath>
          <clipPath id="prep-clip-primer-top"><polygon points={topFace(PRIMER_Y)}></polygon></clipPath>
          <clipPath id="prep-clip-base-top"><polygon points={topFace(BASE_Y)}></polygon></clipPath>
        </defs>

        <g data-prep-layer="slab">
          <g data-prep-lift>
            <polygon points={sideFace(SLAB_Y, SLAB_T)} fill="url(#prep-cut)"></polygon>
            <polygon points={sideFace(SLAB_Y, SLAB_T)} fill="#17222a" opacity="0.36"></polygon>
            <polygon points={frontFace(SLAB_Y, SLAB_T)} fill="url(#prep-cut)"></polygon>
            <polygon points={frontFace(SLAB_Y, SLAB_T)} fill="url(#prep-slab-shade)"></polygon>
            <polygon points={topFace(SLAB_Y)} fill="url(#prep-slab-top)"></polygon>
            <polygon points={topFace(SLAB_Y)} fill="url(#prep-top-light)"></polygon>
            <line x1={FX0} y1={SLAB_Y} x2={FX1} y2={SLAB_Y} stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.4"></line>
            <g fill="none" stroke="rgba(23,34,42,.16)" stroke-width="1">
              <polygon points={frontFace(SLAB_Y, SLAB_T)}></polygon>
              <polygon points={sideFace(SLAB_Y, SLAB_T)}></polygon>
            </g>
          </g>
        </g>

        <g data-prep-layer="grind" clip-path="url(#prep-clip-slab-top)">
          <g data-prep-lift>
            <polygon points={topFace(SLAB_Y)} fill="url(#prep-ground-top)" opacity="0.92"></polygon>
            <g data-prep-swirls fill="none" stroke="#ffffff" stroke-opacity=".32" stroke-width="1.8" stroke-linecap="round">
              {swirls.map((swirl) => (
                <ellipse cx={swirl.cx} cy={swirl.cy} rx={swirl.rx} ry={swirl.ry}></ellipse>
              ))}
            </g>
            <polygon data-prep-dust points={`${FX0},${SLAB_Y - 52} ${FX1 + DX},${SLAB_Y - 52} ${FX1 + DX},${SLAB_Y} ${FX0},${SLAB_Y}`} fill="url(#prep-dust)"></polygon>
          </g>
        </g>

        <g data-prep-layer="repair">
          <g data-prep-lift filter="url(#prep-rag)">
            {[CRACK_FRONT, CRACK_TOP].map((path) => (
              <path data-prep-crack d={path} fill="none" stroke="#403b34" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
            ))}
            {[CRACK_FRONT, CRACK_TOP].map((path) => (
              <path data-prep-fill d={path} fill="none" stroke="#dcd2c0" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
            ))}
          </g>
        </g>

        <g data-prep-layer="primer">
          <g data-prep-lift>
            <polygon points={shadowFace(SLAB_Y)} fill="#17222a" opacity="0.2" filter="url(#prep-soft)" clip-path="url(#prep-clip-slab-top)"></polygon>
            <polygon points={sideFace(PRIMER_Y, PRIMER_T)} fill="#a88450" opacity="0.72"></polygon>
            <polygon points={frontFace(PRIMER_Y, PRIMER_T)} fill="#c49e62" opacity="0.66"></polygon>
            <polygon points={topFace(PRIMER_Y)} fill="url(#prep-primer-top)"></polygon>
            <polygon points={topFace(PRIMER_Y)} fill="url(#prep-top-light)"></polygon>
            <line x1={FX0} y1={PRIMER_Y} x2={FX1} y2={PRIMER_Y} stroke="#fff6e4" stroke-opacity="0.8" stroke-width="1.4"></line>
          </g>
        </g>

        <g data-prep-layer="base">
          <g data-prep-lift>
            <polygon points={shadowFace(PRIMER_Y)} fill="#17222a" opacity="0.22" filter="url(#prep-soft)" clip-path="url(#prep-clip-primer-top)"></polygon>
            <polygon points={sideFace(BASE_Y, BASE_T)} fill="#2a3033"></polygon>
            <polygon points={frontFace(BASE_Y, BASE_T)} fill="#363d41"></polygon>
            <polygon points={topFace(BASE_Y)} fill="url(#prep-base-top)"></polygon>
            <polygon points={topFace(BASE_Y)} fill="url(#prep-top-light)"></polygon>
            <line x1={FX0} y1={BASE_Y} x2={FX1} y2={BASE_Y} stroke="#ffffff" stroke-opacity="0.32" stroke-width="1.2"></line>
          </g>
        </g>

        <g data-prep-layer="flakes" clip-path="url(#prep-clip-base-top)">
          <g data-prep-lift>
            <polygon data-prep-flake-bed points={topFace(BASE_Y)} fill="url(#prep-flake-bed)" opacity="0"></polygon>
            {flakes.map((flake) => (
              <g class="prep-flake" transform={`translate(${flake.x} ${flake.y}) scale(1 0.46) rotate(${flake.rotate})`}>
                <polygon data-prep-flake points={flake.points} fill={flake.tone} stroke="rgba(0,0,0,.28)" stroke-width="0.7"></polygon>
              </g>
            ))}
          </g>
        </g>

        <g data-prep-layer="topcoat">
          <g data-prep-lift>
            <polygon points={shadowFace(BASE_Y)} fill="#17222a" opacity="0.16" filter="url(#prep-soft)" clip-path="url(#prep-clip-base-top)"></polygon>
            <polygon points={sideFace(TOP_Y, TOP_T)} fill="#b7cad6" opacity="0.34"></polygon>
            <polygon points={frontFace(TOP_Y, TOP_T)} fill="#c8d8e2" opacity="0.28"></polygon>
            <polygon points={topFace(TOP_Y)} fill="url(#prep-coat-top)"></polygon>
            {/* A window caught in the clear coat: the reflection that says "gloss". */}
            <polygon points={reflection(TOP_Y)} fill="#ffffff" opacity="0.34" filter="url(#prep-soft)"></polygon>
            <polygon data-prep-gloss-face points={topFace(TOP_Y)} fill="url(#prep-gloss)"></polygon>
            <g fill="none" stroke="rgba(255,255,255,.7)" stroke-width="1.2">
              <polygon points={topFace(TOP_Y)}></polygon>
            </g>
            <line
              data-prep-edge
              x1={FX0 + DX}
              y1={TOP_Y + DY}
              x2={FX1 + DX}
              y2={TOP_Y + DY}
              stroke="#ffffff"
              stroke-width="2.5"
              stroke-linecap="round"
              opacity="0.9"
            ></line>
            <line x1={FX0} y1={TOP_Y} x2={FX1} y2={TOP_Y} stroke="#ffffff" stroke-opacity="0.85" stroke-width="1.6"></line>
          </g>
        </g>
      </svg>
    </div>
    <PrepLayers3D client:visible={{ rootMargin: '600px' }} />
    </div>

    <ol class="prep-captions">
      {captions.map(([index, title, text], position) => (
        <li class="prep-caption" data-prep-caption={layerIds[position]}>
          <span class="prep-caption-rule" data-prep-rule aria-hidden="true"></span>
          <span class="prep-caption-line"><span data-prep-caption-part class="prep-caption-index">{index}</span></span>
          <span class="prep-caption-line"><span data-prep-caption-part class="prep-caption-title">{title}</span></span>
          <span class="prep-caption-line"><span data-prep-caption-part class="prep-caption-text">{text}</span></span>
        </li>
      ))}
    </ol>
  </div>

  <p class="prep-note">Illustrative cross-section, not to scale.</p>
</div>

<script>
  import { initializePreparationLayers } from '../../scripts/preparation-layers';
  const dispose = initializePreparationLayers();
  document.addEventListener('astro:before-swap', dispose, { once: true });
</script>
